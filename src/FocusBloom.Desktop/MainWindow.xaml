<Window x:Class="FocusBloom.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FocusBloom.Desktop.Views"
        xmlns:present="clr-namespace:FocusBloom.Desktop.Presentation"
        Title="一刻专注 · FocusBloom" Style="{StaticResource {x:Type Window}}"
        Icon="{StaticResource BrandLogo}"
        Width="1120" Height="720" MinWidth="900" MinHeight="560" WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="SettingsSection" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,10" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
                <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12" Cursor="Hand"><DockPanel><TextBlock x:Name="Arrow" DockPanel.Dock="Right" Text="＋" Foreground="{DynamicResource MutedBrush}" FontSize="16" /><ContentPresenter TextElement.FontSize="15" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource TextBrush}" /></DockPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="－" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="Details" Visibility="Collapsed" />
            </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="NavigationLabel" TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding NavigationCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="NavigationIcon" TargetType="TextBlock"><Setter Property="Margin" Value="0,2,12,0" /><Style.Triggers><DataTrigger Binding="{Binding NavigationCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Margin" Value="0,2,0,0" /></DataTrigger></Style.Triggers></Style>
    </Window.Resources>
    <Grid>
    <Grid x:Name="WorkspaceView">
        <Grid.RowDefinitions><RowDefinition Height="88" /><RowDefinition Height="*" /><RowDefinition Height="42" /></Grid.RowDefinitions>
        <Border x:Name="WorkspaceHeader" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="30,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="TimerFloatToggle" Content="计时浮窗" IsChecked="{Binding TimerFloatVisible}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <CheckBox Content="窗口置顶" IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}"
                              Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <Button x:Name="EnterFullscreenButton" Content="全屏  ↗" Click="ToggleFullscreen_Click" Padding="18,10" ToolTip="F11 切换，Esc 返回" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="HeaderLogo" Source="{StaticResource BrandLogo}" Width="42" Height="42" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip><RectangleGeometry Rect="0,0,42,42" RadiusX="10" RadiusY="10" /></Image.Clip>
                    </Image>
                    <StackPanel>
                        <TextBlock Text="一刻专注" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="FocusBloom" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock Text="把时间留给喜欢的事" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="44,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
        <TabControl x:Name="MainTabs" Grid.Row="1" TabStripPlacement="Left" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem x:Name="FocusTab" ToolTip="专注时刻">
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE916;" Style="{StaticResource NavigationIcon}" /><TextBlock Style="{StaticResource NavigationLabel}" Text="专注时刻" /></StackPanel></TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,22">
                        <TextBlock Text="留一刻，给自己" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="选一件想做的事，让专注慢慢发生。" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                        <Border CornerRadius="24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{DynamicResource HeroStartColor}" Offset="0" /><GradientStop Color="{DynamicResource HeroMiddleColor}" Offset="0.55" /><GradientStop Color="{DynamicResource HeroEndColor}" Offset="1" /></LinearGradientBrush></Border.Background>
                            <Grid>
                                <views:FocusBackgroundView x:Name="FocusBackground" DataContext="{Binding Media}" BackgroundImage="{Binding Background}" AnimatedUri="{Binding BackgroundGifUri}" VideoUri="{Binding BackgroundVideoUri}" CornerRadius="24" />
                                <Border CornerRadius="24" Background="#6B0D1826" Visibility="{Binding Media.HasBackground, Converter={StaticResource BoolVisibility}}" />
                                <Grid Margin="24,20">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <TextBlock Text="{Binding SessionModeText}" Style="{StaticResource SceneCaption}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <Button x:Name="OpenStudyBrowserButton" Content="学习浏览器  ↗" Click="OpenStudyBrowser_Click" Style="{StaticResource SceneQuietButton}" ToolTip="打开学习浏览器" />
                                        </StackPanel>
                                        <TextBlock Text="F O C U S B L O O M" Style="{StaticResource SceneCaption}" FontSize="11" />
                                    </DockPanel>
                                    <Viewbox Grid.Row="1" Margin="0,12" Stretch="Uniform" StretchDirection="DownOnly">
                                        <StackPanel Width="420" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding FocusHeading}" Style="{StaticResource SceneText}" FontSize="21" FontWeight="Medium" HorizontalAlignment="Center" TextAlignment="Center" />
                                            <TextBlock Text="{Binding FocusTodoText}" Style="{StaticResource SceneCaption}" FontSize="13" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" Visibility="{Binding HasFocusTodo, Converter={StaticResource BoolVisibility}}" />
                                            <TextBlock x:Name="TimerDisplay" Text="{Binding TimerText}" Style="{StaticResource SceneText}" FontFamily="{DynamicResource FocusTimerFont}" FontWeight="Light" Typography.NumeralAlignment="Tabular" FontSize="72" HorizontalAlignment="Center" Margin="0,16,0,10" />
                                            <TextBlock Text="{Binding StateText}" Style="{StaticResource SceneText}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding PhaseText}" Style="{StaticResource SceneCaption}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                            <TextBlock x:Name="FocusQuoteDisplay" Text="{Binding Media.QuoteText}" Style="{StaticResource SceneText}" FontFamily="{DynamicResource FocusQuoteFont}" TextAlignment="Center" FontSize="18" LineHeight="30" MaxHeight="120" TextTrimming="CharacterEllipsis" Margin="15,24,15,0" />
                                            <present:QuoteAttributionText Quote="{Binding Media.CurrentQuote}" Style="{StaticResource SceneCaption}" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0" ToolTip="{Binding Media.QuoteSource}" />
                                        </StackPanel>
                                    </Viewbox>
                                    <Grid Grid.Row="2">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <WrapPanel HorizontalAlignment="Center">
                                            <Button x:Name="StartButton" Content="开始专注  →" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Width="200" Padding="24,12" Visibility="{Binding ShowStart, Converter={StaticResource BoolVisibility}}" />
                                            <Button x:Name="PauseButton" Content="暂停" Command="{Binding PauseCommand}" Style="{StaticResource SceneButton}" Margin="0,0,10,0" Width="110" Visibility="{Binding ShowPause, Converter={StaticResource BoolVisibility}}" />
                                            <Button x:Name="ResumeButton" Content="继续专注" Command="{Binding ResumeCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Width="120" Visibility="{Binding ShowResume, Converter={StaticResource BoolVisibility}}" />
                                            <Button x:Name="EndButton" Content="结束" Command="{Binding EndCommand}" Style="{StaticResource SceneButton}" Width="100" Visibility="{Binding ShowEnd, Converter={StaticResource BoolVisibility}}" Margin="0,0,10,0" />
                                            <Button Content="跳过休息" Command="{Binding SkipRestCommand}" Style="{StaticResource PrimaryButton}" Width="180" Visibility="{Binding ShowSkipRest, Converter={StaticResource BoolVisibility}}" />
                                        </WrapPanel>
                                        <Grid Grid.Row="1" Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <ToggleButton x:Name="FocusKeepScreenOnButton" Content="常亮" IsChecked="{Binding KeepScreenOn}" Style="{StaticResource SceneUtilityToggle}" HorizontalAlignment="Left" ToolTip="保持屏幕常亮，专注与暂停时生效" />
                                            <Button Grid.Column="1" ToolTip="{Binding Media.ImageSourceInfo}" Command="{Binding Media.OpenImageSourceCommand}" Opacity="0.5" FontSize="9" VerticalAlignment="Center" MaxWidth="170"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SceneQuietButton}"><Style.Triggers><DataTrigger Binding="{Binding ShowOutcomeEntry}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="{Binding Media.ImageCredit}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></Button>
                                            <ToggleButton x:Name="FocusSoundPanelButton" Grid.Column="2" Content="声音" Style="{StaticResource SceneUtilityToggle}" HorizontalAlignment="Right" ToolTip="音源、播放与音量" />
                                            <Button Grid.Column="1" Content="补记成果（可选）" Click="LatestOutcome_Click" Style="{StaticResource SceneQuietButton}" FontSize="11" Visibility="{Binding ShowOutcomeEntry, Converter={StaticResource BoolVisibility}}" />
                                        </Grid>
                                        <Popup x:Name="FocusSoundPopup" IsOpen="{Binding IsChecked, ElementName=FocusSoundPanelButton}" PlacementTarget="{Binding ElementName=FocusSoundPanelButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
                                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Width="340" DataContext="{Binding Media}"><views:FocusAudioControls /></Border>
                                        </Popup>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22">
                            <DockPanel>
                                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SubtleBrush}" CornerRadius="12" Padding="14" Margin="0,18,0,0">
                                    <TextBlock Text="暂停和休息不计入专注时长。番茄循环每轮单独记录，专注不足10秒不计入。" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" />
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock Text="这次，专注什么？" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,22" />
                                        <TextBlock x:Name="FocusConfigurationHint" Text="结束本次专注或休息后，可修改项目和计时设置。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CanConfigure}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel IsEnabled="{Binding CanConfigure}">
                                            <TextBlock Text="文件夹" Style="{StaticResource Caption}" />
                                            <ComboBox x:Name="FocusFolderSelector" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" DisplayMemberPath="Name" Margin="0,0,0,16" />
                                            <TextBlock Text="专注项目" Style="{StaticResource Caption}" />
                                            <ComboBox x:Name="ProjectSelector" ItemsSource="{Binding FolderProjects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Name" Margin="0,0,0,16" />
                                            <TextBlock Text="待办文件夹（可选）" Style="{StaticResource Caption}" />
                                            <ComboBox x:Name="FocusTodoFolderSelector" ItemsSource="{Binding FocusTodoFolderChoices}" SelectedItem="{Binding SelectedFocusTodoFolder}" DisplayMemberPath="Name" Margin="0,0,0,16" />
                                            <TextBlock Text="关联待办事项" Style="{StaticResource Caption}" />
                                            <ComboBox x:Name="FocusTodoSelector" ItemsSource="{Binding FolderFocusTodoChoices}" SelectedItem="{Binding SelectedFocusTodo}" DisplayMemberPath="Title" IsEnabled="{Binding HasFocusTodoFolder}" Margin="0,0,0,16" />
                                            <TextBlock Text="计时方式" Style="{StaticResource Caption}" />
                                            <ComboBox x:Name="TimerModeSelector" ItemsSource="{Binding TimerModes}" SelectedItem="{Binding SelectedTimerMode}" DisplayMemberPath="Name" Margin="0,0,0,16" />
                                            <TextBlock Text="专注模式" Style="{StaticResource Caption}" />
                                            <ComboBox x:Name="RestrictionModeSelector" ItemsSource="{Binding RestrictionModes}" SelectedItem="{Binding SelectedRestrictionMode}" DisplayMemberPath="Name" Margin="0,0,0,16" />
                                            <StackPanel Visibility="{Binding Countdown, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,16">
                                                <TextBlock Text="专注时长 / 分钟" Style="{StaticResource Caption}" />
                                                <TextBox Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <Grid Visibility="{Binding SingleTimer, Converter={StaticResource BoolVisibility}}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="暂停 / 分钟" Style="{StaticResource Caption}" /><TextBox Text="{Binding PauseMinutes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Text="休息 / 分钟" Style="{StaticResource Caption}" /><TextBox Text="{Binding RestMinutes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            </Grid>
                                            <views:PomodoroSettingsView x:Name="PomodoroConfiguration" Visibility="{Binding Pomodoro, Converter={StaticResource BoolVisibility}}" />
                                            <StackPanel Visibility="{Binding Pomodoro, Converter={StaticResource BoolVisibility}}" Margin="0,14,0,0">
                                                <TextBlock Text="暂停 / 分钟" Style="{StaticResource Caption}" /><TextBox Text="{Binding PauseMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Background="{DynamicResource SubtleBrush}" CornerRadius="10" Padding="12" Margin="0,16,0,0" Visibility="{Binding HasResumeNote, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="接着上次继续" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,0,6" /><TextBlock Text="{Binding FocusResumeNote}" FontSize="12" TextWrapping="Wrap" /></StackPanel></Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="ProjectsTab" ToolTip="项目库">
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" Style="{StaticResource NavigationIcon}" /><TextBlock Style="{StaticResource NavigationLabel}" Text="项目库" /></StackPanel></TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,22"><TextBlock Text="把想做的事，整理好" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="文件夹收纳同类项目，每个项目记录自己的专注时间。" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" /></StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="220" /><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=ProjectSidebarToggle}" Value="True"><Setter Property="Width" Value="0" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
                            <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="20" /><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=ProjectSidebarToggle}" Value="True"><Setter Property="Width" Value="0" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
                            <ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border x:Name="ProjectFoldersPane" Padding="14,20"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=ProjectSidebarToggle}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="8,0,8,16"><TextBlock Text="我的文件夹" FontWeight="SemiBold" FontSize="16" /></StackPanel>
                                <Border x:Name="NewFolderArea" DockPanel.Dock="Bottom" Margin="6,10,6,0">
                                    <Button x:Name="AddFolderButton" Content="＋ 新建文件夹" Click="NewFolder_Click" Padding="10,8" Height="36" FontSize="12" />
                                </Border>
                                <ListBox x:Name="FolderList" present:ReorderButton.EnableDrop="True" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" ItemContainerStyle="{StaticResource FolderItem}">
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                                            <Path Data="M 2,5 L 9,5 L 12,8 L 22,8 L 22,21 L 2,21 Z" Width="23" Height="20" Stretch="Uniform" Fill="{DynamicResource AccentSoftBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Margin="0,4,12,0" />
                                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /><TextBlock Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" /></StackPanel>
                                            <present:ReorderButton Grid.Column="2" VerticalAlignment="Top" ReorderRequested="FolderOrder_Requested" />
                                            <Button Grid.Column="3" Content="···" Click="EditFolder_Click" Width="26" Height="26" Padding="0" FontSize="16" VerticalAlignment="Top" Background="Transparent" ToolTip="修改或删除文件夹" />
                                        </Grid>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                        <Border x:Name="ProjectContentCard" Grid.Column="2" Style="{StaticResource Card}" Padding="24">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,22">
                                    <Border x:Name="NewProjectArea" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"><Button x:Name="AddProjectButton" Content="＋ 新建项目" Click="NewProject_Click" Style="{StaticResource PrimaryButton}" Padding="12,7" Height="36" FontSize="12" /></Border>
                                    <ToggleButton x:Name="ProjectSidebarToggle" DockPanel.Dock="Left" Style="{StaticResource SidebarToggle}" ToolTip="展开或收起文件夹" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel><TextBlock Text="{Binding FolderTitle}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding FolderSummary}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" /></StackPanel>
                                </DockPanel>
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsFolderEmpty, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="46" Foreground="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="文件夹还是空的" Foreground="{DynamicResource MutedBrush}" Margin="0,18,0,8" HorizontalAlignment="Center" />
                                        <TextBlock Text="添加第一个想专注的项目吧" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                    </StackPanel>
                                    <ListBox x:Name="ProjectList" present:ReorderButton.EnableDrop="True" ItemsSource="{Binding FolderProjects}" SelectedItem="{Binding SelectedProject}" ScrollViewer.VerticalScrollBarVisibility="Visible">
                                        <ListBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}"><Style.Triggers><Trigger Property="Maximum" Value="0"><Setter Property="Opacity" Value="0" /></Trigger></Style.Triggers></Style></ListBox.Resources>
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource ProjectItem}"><Setter Property="Height" Value="{DynamicResource ProjectCardHeight}" /><Setter Property="VerticalAlignment" Value="Top" /><Setter Property="Margin" Value="0,0,10,10" /></Style></ListBox.ItemContainerStyle>
                                        <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{DynamicResource ProjectCardColumns}" VerticalAlignment="Top" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate><DataTemplate>
                                            <Border LayoutTransform="{DynamicResource ProjectCardTransform}" Height="120" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Background="{DynamicResource FieldBrush}">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,8">
                                                        <Button DockPanel.Dock="Right" Content="···" Click="EditProject_Click" Width="26" Height="26" Padding="0" FontSize="16" VerticalAlignment="Top" HorizontalAlignment="Right" Background="Transparent" ToolTip="修改或删除项目" />
                                                        <present:ReorderButton DockPanel.Dock="Right" VerticalAlignment="Top" ReorderRequested="ProjectOrder_Requested" />
                                                        <Border Background="{DynamicResource SubtleBrush}" Width="32" Height="32" CornerRadius="8" HorizontalAlignment="Left"><Path Data="M 3,1 L 16,1 L 23,8 L 23,31 L 3,31 Z M 16,1 L 16,8 L 23,8" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" Fill="{DynamicResource AccentSoftBrush}" StrokeThickness="1.5" Margin="9,6" /></Border>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="TodoTab" ToolTip="待办事项">
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73A;" Style="{StaticResource NavigationIcon}" /><TextBlock Style="{StaticResource NavigationLabel}" Text="待办事项" /></StackPanel></TabItem.Header>
                <views:TodosView x:Name="TodoPage" DataContext="{Binding Todos}" />
            </TabItem>
            <TabItem x:Name="CalendarTab" ToolTip="日历与课表">
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" Style="{StaticResource NavigationIcon}" /><TextBlock Style="{StaticResource NavigationLabel}" Text="日历与课表" /></StackPanel></TabItem.Header>
                <views:CalendarView x:Name="CalendarPage" DataContext="{Binding Calendar}" />
            </TabItem>
            <TabItem x:Name="DateEventsTab" ToolTip="日期事项">
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE916;" Style="{StaticResource NavigationIcon}" /><TextBlock Style="{StaticResource NavigationLabel}" Text="日期事项" /></StackPanel></TabItem.Header>
                <views:DateEventsView DataContext="{Binding DateEvents}" />
            </TabItem>
            <TabItem x:Name="RecordsTab" ToolTip="专注记录">
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" Style="{StaticResource NavigationIcon}" /><TextBlock Style="{StaticResource NavigationLabel}" Text="专注记录" /></StackPanel></TabItem.Header>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="重试保存" Command="{Binding RetrySaveCommand}" Visibility="{Binding HasUnsavedRecord, Converter={StaticResource BoolVisibility}}" />
                        <TextBlock DockPanel.Dock="Left" Text="专注记录" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="RecordTimelineButton" Content="时间轴" Tag="时间轴" Click="RecordPage_Click" Padding="12,6" FontSize="12" Margin="0,0,6,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding RecordPage}" Value="时间轴"><Setter Property="Background" Value="{DynamicResource SelectedBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                            <Button x:Name="RecordStatisticsButton" Content="统计" Tag="统计" Click="RecordPage_Click" Padding="12,6" FontSize="12" Margin="0,0,6,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding RecordPage}" Value="统计"><Setter Property="Background" Value="{DynamicResource SelectedBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                            <Button x:Name="RecordReviewButton" Content="复盘" Tag="复盘" Click="RecordPage_Click" Padding="12,6" FontSize="12"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding RecordPage}" Value="复盘"><Setter Property="Background" Value="{DynamicResource SelectedBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                        </StackPanel>
                    </DockPanel>
                    <views:CalendarView x:Name="FocusCalendarPage" Grid.Row="1" DataContext="{Binding FocusCalendar}" Visibility="{Binding DataContext.ShowRecordCalendar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" />
                    <views:StatisticsView x:Name="StatisticsPage" Grid.Row="1" DataContext="{Binding Statistics}" Visibility="{Binding DataContext.ShowRecordStatistics, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" />
                </Grid>
            </TabItem>
            <TabItem x:Name="PreferencesTab" ToolTip="偏好设置">
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Style="{StaticResource NavigationIcon}" /><TextBlock Style="{StaticResource NavigationLabel}" Text="偏好设置" /></StackPanel></TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,22"><TextBlock Text="找到自己的节奏" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="按功能展开，或用关键词快速找到设置。" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" /></StackPanel>
                    <DockPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock Text="搜索设置" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource MutedBrush}" /><TextBox x:Name="SettingsSearchInput" TextChanged="SettingsSearch_Changed" ToolTip="输入字体、背景、颜色、提醒等关键词" /></DockPanel>
                    <ScrollViewer x:Name="PreferencesScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" ScrollChanged="PreferencesScroll_Changed">
                        <StackPanel>
                            <TextBlock x:Name="SettingsSearchEmpty" Text="没有匹配的设置，试试字体、背景或提醒等关键词。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed" />
                            <Expander x:Name="NavigationSettingsSection" Header="导航展示与顺序" Style="{StaticResource SettingsSection}">
                                <Border Style="{StaticResource Card}" Margin="0,8,0,0"><StackPanel>
                                    <TextBlock Text="勾选要显示的栏目，拖动右侧手柄调整顺序。偏好设置入口始终保留。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,12" />
                                    <ItemsControl x:Name="NavigationSettingsItems" ItemsSource="{Binding Navigation.Items}" present:ReorderButton.EnableDrop="True"><ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Background="{DynamicResource FieldBrush}" CornerRadius="10" Padding="12,9" Margin="0,0,0,6"><DockPanel>
                                            <present:ReorderButton DockPanel.Dock="Right" ReorderRequested="NavigationOrder_Requested" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" />
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding Visible}" IsEnabled="{Binding CanHide}" VerticalAlignment="Center" />
                                        </DockPanel></Border>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </StackPanel></Border>
                            </Expander>

                            <Expander x:Name="MediaSettingsSection" Header="专注图文与声音" Style="{StaticResource SettingsSection}"><Border x:Name="FocusMediaSettingsCard" Style="{StaticResource Card}" Margin="0,8,0,0"><views:FocusMediaSettingsView DataContext="{Binding Media}" /></Border></Expander>
                            <Expander x:Name="AppearanceSettingsSection" Header="外观与配色" Style="{StaticResource SettingsSection}"><Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                <StackPanel>

                                    <TextBlock Text="马卡龙与莫兰迪，选一种今天喜欢的颜色。" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,20" />
                                    <ListBox Style="{StaticResource FlowCardList}" x:Name="PaletteSelector" ItemsSource="{Binding Palettes}" SelectedItem="{Binding SelectedPalette}" ItemContainerStyle="{StaticResource ProjectItem}">
                                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate><DataTemplate>
                                            <Border Width="210" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="25" Height="25" Fill="{Binding Swatch}" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="明暗模式" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,18,0" />
                                        <ComboBox x:Name="AppearanceModeSelector" Width="180" ItemsSource="{Binding AppearanceModes}" SelectedItem="{Binding SelectedAppearanceMode}" DisplayMemberPath="Name" />
                                        <TextBlock Text="选择后立即应用，并在本机保存" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="18,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border></Expander>
                            <Expander x:Name="FontSettingsSection" Header="专注字体" Style="{StaticResource SettingsSection}"><Border x:Name="FocusFontSettingsCard" Style="{StaticResource Card}" Margin="0,8,0,0"><views:FocusFontSettingsView DataContext="{Binding Typography}" /></Border></Expander>
                            <Expander x:Name="FloatSettingsSection" Header="桌面浮窗与组件" Style="{StaticResource SettingsSection}"><Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                <StackPanel>

                                    <CheckBox Content="显示计时浮窗" IsChecked="{Binding TimerFloatVisible}" />
                                    <TextBlock Text="共用当前计时，主窗口进入托盘后继续显示。在浮窗设置里选择置顶、背景和透明度；关闭浮窗不会结束专注。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
                                    <views:DesktopWidgetSettingsView x:Name="DesktopWidgetSettings" DataContext="{Binding Widgets}" />
                                </StackPanel>
                            </Border></Expander>
                            <Expander x:Name="SizeSettingsSection" Header="事项块大小" Style="{StaticResource SettingsSection}"><Border Style="{StaticResource Card}" Margin="0,8,0,0"><StackPanel>

                                <TextBlock Text="按板块调整大小，立即生效并保存。100% 为默认大小。" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,14" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="选择板块" Style="{StaticResource Caption}" />
                                        <ComboBox x:Name="CardSizeSelector" ItemsSource="{Binding CardSizing.Options}" SelectedItem="{Binding CardSizing.PreviewOption}" DisplayMemberPath="Name" />
                                        <StackPanel DataContext="{Binding CardSizing.PreviewOption}" Margin="0,18,0,0">
                                            <DockPanel><TextBlock Text="大小" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{Binding PercentageText}" HorizontalAlignment="Right" FontWeight="SemiBold" /></DockPanel>
                                            <Slider x:Name="CardSizeSlider" Minimum="70" Maximum="140" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Percentage, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,12" />
                                            <TextBlock Text="{Binding PreviewDescription}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                            <Button Content="恢复默认大小" Command="{Binding ResetCommand}" Padding="10,7" FontSize="11" HorizontalAlignment="Left" Margin="0,18,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" DataContext="{Binding CardSizing.PreviewOption}">
                                        <TextBlock Text="实时预览" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" />
                                        <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="12" Padding="14" Height="285">
                                            <Border x:Name="CardSizePreview" Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" LayoutTransform="{Binding PreviewTransform}" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="{Binding PreviewPadding}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding PreviewTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding PreviewDetail}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" Visibility="{Binding ShowPreviewDetail, Converter={StaticResource BoolVisibility}}" /></StackPanel>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel></Border></Expander>
                            <Expander x:Name="ReminderSettingsSection" Header="日历与软件提醒" Style="{StaticResource SettingsSection}"><Border Style="{StaticResource Card}" Margin="0,8,0,0"><StackPanel>

                                <CheckBox x:Name="SoftwareReminderToggle" Content="开启软件提醒" IsChecked="{Binding SoftwareRemindersEnabled}" />
                                <TextBlock Text="总开关控制待办截止、日期事项、课程及计划安排的系统通知；关闭后保留各事项设置。" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,14" />
                                <CheckBox x:Name="OutlookSyncToggle" Content="与 Windows／Outlook 日历同步（待接入）" IsChecked="{Binding OutlookSyncRequested}" />
                                <TextBlock Text="{Binding OutlookSyncStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,0" />
                            </StackPanel></Border></Expander>
                            <Expander x:Name="TimerSettingsSection" Header="计时与番茄" Style="{StaticResource SettingsSection}"><Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                <StackPanel>

                                    <Grid MaxWidth="540" HorizontalAlignment="Left" Width="540" Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="默认计时方式" Style="{StaticResource Caption}" />
                                            <ComboBox x:Name="DefaultTimerModeSelector" ItemsSource="{Binding TimerModes}" SelectedItem="{Binding DefaultTimerMode}" DisplayMemberPath="Name" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="默认专注模式" Style="{StaticResource Caption}" />
                                            <ComboBox x:Name="DefaultRestrictionModeSelector" ItemsSource="{Binding RestrictionModes}" SelectedItem="{Binding DefaultRestrictionMode}" DisplayMemberPath="Name" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid MaxWidth="540" HorizontalAlignment="Left" Width="540">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="默认暂停 / 分钟" Style="{StaticResource Caption}" /><TextBox Text="{Binding PauseMinutes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="默认休息 / 分钟" Style="{StaticResource Caption}" /><TextBox Text="{Binding RestMinutes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    </Grid>
                                    <TextBlock Text="保存后，每次开始默认采用所选方式和模式；也可在专注页临时调整本次选择。当前会话保持原设置，休息 0 分钟表示不休息。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,18,0,20" />
                                    <views:PomodoroSettingsView x:Name="PomodoroPreferences" Visibility="{Binding DefaultPomodoro, Converter={StaticResource BoolVisibility}}" MaxWidth="540" HorizontalAlignment="Left" Width="540" Margin="0,0,0,20" />
                                    <Button x:Name="SaveTimerPreferencesButton" Content="保存偏好" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border></Expander>
                            <Expander x:Name="BackupSettingsSection" Header="数据备份与恢复" Style="{StaticResource SettingsSection}"><Border Style="{StaticResource Card}" Margin="0,8,0,0"><views:BackupSettingsView x:Name="BackupSettings" /></Border></Expander>
                            <Expander x:Name="RestrictionSettingsSection" Header="严格模式规则" Style="{StaticResource SettingsSection}"><Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                <StackPanel>

                                    <TextBlock Text="外部浏览器由独立扩展控制，请在扩展中设置网站规则并开始专注。" Foreground="{DynamicResource AccentTextBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="应用和网站分别选择黑名单或白名单，各自列表独立保存。本次专注采用开始时的规则，暂停保持限制，休息和结束解除限制。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,20" />
                                    <TextBlock x:Name="RestrictionEditHint" Text="请先结束专注，再修改应用和网站规则。" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,0,16" TextWrapping="Wrap">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CanEditWhitelist}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel IsEnabled="{Binding CanEditWhitelist}">
                                        <TextBlock Text="应用限制方式" Style="{StaticResource Caption}" />
                                        <ComboBox x:Name="ApplicationAccessModeSelector" ItemsSource="{Binding Whitelist.ListModes}" SelectedItem="{Binding Whitelist.ApplicationMode}" DisplayMemberPath="Name" Margin="0,0,0,16" />
                                        <TextBlock Text="{Binding Whitelist.ApplicationListTitle}" Style="{StaticResource Caption}" />
                                        <ListBox x:Name="RestrictionApplicationList" ItemsSource="{Binding Whitelist.Applications}" SelectedItem="{Binding Whitelist.SelectedApplication}" MaxHeight="180" ItemContainerStyle="{StaticResource FolderItem}">
                                            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding ExecutablePath}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                                        </ListBox>
                                        <WrapPanel Margin="0,10,0,12">
                                            <Button Content="选择运行中的应用" Click="SelectRunningApplication_Click" Margin="0,0,12,8" />
                                            <Button Content="选择程序文件" Click="SelectApplicationFile_Click" Margin="0,0,12,8" />
                                            <Button Content="移除应用" Click="RemoveApplication_Click" Margin="0,0,0,8" />
                                        </WrapPanel>
                                        <TextBlock Text="软件自身、必要系统界面、任务管理器、Windows 截图工具和照片查看器自动放行。白名单只允许列表内应用；黑名单只限制列表内应用。浏览器应用可操作后，启用并连接扩展才能执行网站规则。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,22" />
                                        <TextBlock Text="网站限制方式" Style="{StaticResource Caption}" />
                                        <ComboBox x:Name="WebsiteAccessModeSelector" ItemsSource="{Binding Whitelist.ListModes}" SelectedItem="{Binding Whitelist.WebsiteMode}" DisplayMemberPath="Name" Margin="0,0,0,16" />
                                        <TextBlock Text="{Binding Whitelist.WebsiteListTitle}" Style="{StaticResource Caption}" />
                                        <ListBox x:Name="RestrictionWebsiteList" ItemsSource="{Binding Whitelist.Websites}" SelectedItem="{Binding Whitelist.SelectedWebsite}" DisplayMemberPath="Description" MaxHeight="180" ItemContainerStyle="{StaticResource FolderItem}" />
                                        <TextBox Text="{Binding Whitelist.Domain, UpdateSourceTrigger=PropertyChanged}" ToolTip="域名或网址，例如 example.edu" Margin="0,12,0,12" />
                                        <CheckBox Content="规则包含子域名" IsChecked="{Binding Whitelist.IncludeSubdomains}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14" />
                                        <WrapPanel>
                                            <Button Content="保存网站" Command="{Binding Whitelist.SaveWebsiteCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,8" />
                                            <Button Content="新建网站" Command="{Binding Whitelist.NewWebsiteCommand}" Margin="0,0,12,8" />
                                            <Button Content="删除网站" Click="RemoveWebsite_Click" Margin="0,0,0,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border></Expander>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="退出一刻专注" Click="Exit_Click" VerticalAlignment="Center" Margin="22,0,0,0" />
                                    <StackPanel><TextBlock Text="后台与退出" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="关闭窗口进入托盘，计时继续。明确退出时结束专注并保存记录。" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,12,0,0" /></StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="GoalsTab" ToolTip="目标与习惯">
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE734;" Style="{StaticResource NavigationIcon}" /><TextBlock Style="{StaticResource NavigationLabel}" Text="目标与习惯" /></StackPanel></TabItem.Header>
                <views:GoalsView x:Name="GoalsPage" DataContext="{Binding Goals}" />
            </TabItem>
            <TabItem x:Name="BrowserTab">
                <TabItem.Style><Style TargetType="TabItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border Visibility="Collapsed" /></ControlTemplate></Setter.Value></Setter></Style></TabItem.Style>
            </TabItem>
            <TabItem x:Name="ReflectionTab"><views:ReflectionView x:Name="ReflectionPage" DataContext="{Binding Reflection}" /></TabItem>
        </TabControl>
        <TextBlock x:Name="StatusDisplay" Grid.Row="2" Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="210,0,28,0" VerticalAlignment="Center" />
    </Grid>
    <views:FullscreenFocusView x:Name="FullscreenView" Visibility="Collapsed" ReturnToWindowRequested="ReturnToWindowRequested" OpenBrowserRequested="FullscreenOpenBrowserRequested" />
    <Border x:Name="BrowserFullscreenView" Background="{DynamicResource BackgroundBrush}" Padding="28" Visibility="Collapsed">
        <ContentControl x:Name="BrowserFullscreenHost" />
    </Border>
    <Button x:Name="ExitContentFullscreenButton" Content="返回窗口 · Esc" Click="ToggleFullscreen_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,18,0" Padding="12,7" FontSize="11" Visibility="{Binding ContentFullscreen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" />
    </Grid>
</Window>
