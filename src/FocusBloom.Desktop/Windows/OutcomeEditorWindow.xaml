<Window x:Class="FocusBloom.Desktop.Windows.OutcomeEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="补记专注成果" Style="{StaticResource {x:Type Window}}" Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="28"><TextBlock Text="这一刻，完成了什么？" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,10" /><TextBlock x:Name="RecordHeading" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,18" />
        <TextBlock Text="成果（可选）" Style="{StaticResource Caption}" /><TextBox x:Name="SummaryInput" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14" />
        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="数量（可选）" Style="{StaticResource Caption}" /><TextBox x:Name="QuantityInput" /></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="单位，例如页、题、字" Style="{StaticResource Caption}" /><TextBox x:Name="UnitInput" /></StackPanel>
        </Grid>
        <TextBlock Text="下次从哪里继续（可选）" Style="{StaticResource Caption}" /><TextBox x:Name="NextInput" AcceptsReturn="True" TextWrapping="Wrap" Height="75" VerticalScrollBarVisibility="Auto" />
        <TextBlock Text="可以稍后再填。专注记录已经保存，休息或下一轮计时照常进行。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0" />
        <TextBlock x:Name="ValidationMessage" Foreground="{DynamicResource AccentTextBrush}" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="稍后再填" IsCancel="True" Margin="0,0,12,0" /><Button x:Name="SaveButton" Content="保存成果" Click="Save_Click" Style="{StaticResource PrimaryButton}" IsDefault="True" /></StackPanel>
    </StackPanel>
</Window>
