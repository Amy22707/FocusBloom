<Window x:Class="FocusBloom.Desktop.Windows.ApplicationPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择运行中的应用" Icon="{StaticResource BrandLogo}" Style="{StaticResource {x:Type Window}}"
        Width="620" Height="480" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="选择允许在严格专注中操作的应用" FontSize="18" Margin="0,0,0,20" />
        <Button DockPanel.Dock="Bottom" Content="加入白名单" Click="Add_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,20,0,0" />
        <ListBox x:Name="ApplicationList" ItemContainerStyle="{StaticResource FolderItem}">
            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding ExecutablePath}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
