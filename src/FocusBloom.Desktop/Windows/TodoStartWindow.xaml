<Window x:Class="FocusBloom.Desktop.Windows.TodoStartWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:FocusBloom.Desktop.Views"
        Title="从待办开始专注" Style="{StaticResource {x:Type Window}}" Width="480" Height="600" MinWidth="440" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock x:Name="TodoHeading" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" /><TextBlock x:Name="StartHint" Foreground="{DynamicResource MutedBrush}" FontSize="12" /></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="计时方式" Style="{StaticResource Caption}" /><ComboBox x:Name="TimerSelector" DisplayMemberPath="Name" SelectionChanged="Timer_Changed" /></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="专注模式" Style="{StaticResource Caption}" /><ComboBox x:Name="RestrictionSelector" DisplayMemberPath="Name" /></StackPanel>
        </Grid>
        <StackPanel x:Name="CountdownArea" Margin="0,0,0,14" Visibility="Collapsed"><TextBlock Text="专注时长 / 分钟" Style="{StaticResource Caption}" /><TextBox x:Name="DurationInput" /></StackPanel>
        <views:PomodoroSettingsView x:Name="CycleSettings" Margin="0,0,0,18" Visibility="Collapsed" />
        <TextBlock Text="计时文件夹（项目库，可选）" Style="{StaticResource Caption}" /><ComboBox x:Name="CategorySelector" DisplayMemberPath="Name" SelectionChanged="Category_Changed" Margin="0,0,0,14" />
        <TextBlock Text="计时项目（可选）" Style="{StaticResource Caption}" /><ComboBox x:Name="ProjectSelector" DisplayMemberPath="Name" Margin="0,0,0,14" />
        <TextBlock Text="未选项目时使用所选文件夹的“未分类”项目；文件夹也留空则进入“未分类”。计时关联待办，结束不会自动标记完成。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
        <TextBlock x:Name="ValidationMessage" Foreground="{DynamicResource AccentTextBrush}" Margin="0,12,0,0" />
    </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="取消" IsCancel="True" Margin="0,0,12,0" /><Button x:Name="StartButton" Content="开始专注" Click="Start_Click" Style="{StaticResource PrimaryButton}" IsDefault="True" /></StackPanel>
    </Grid>
</Window>
