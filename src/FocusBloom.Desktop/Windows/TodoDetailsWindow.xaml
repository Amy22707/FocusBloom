<Window x:Class="FocusBloom.Desktop.Windows.TodoDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办详情" Style="{StaticResource {x:Type Window}}" Width="500" Height="480" MinWidth="420" MinHeight="360" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20"><TextBlock x:Name="DetailTitle" Text="{Binding Title}" FontSize="23" FontWeight="SemiBold" /><TextBlock x:Name="FolderLocation" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0" /></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,18"><StackPanel>
                <WrapPanel><TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,14,0" /><TextBlock Text="{Binding QuadrantText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" /></WrapPanel>
                <TextBlock x:Name="DetailDue" Text="{Binding DueText}" Margin="0,10,0,0" /><TextBlock Text="{Binding PriorityText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,0" />
                <TextBlock Text="{Binding InvestmentText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="先做5分钟" Tag="5" Click="Focus_Click" Padding="10,5" FontSize="11" Margin="0,0,8,0" /><Button Content="先做10分钟" Tag="10" Click="Focus_Click" Padding="10,5" FontSize="11" /></StackPanel>
            </StackPanel></Border>
            <StackPanel Margin="0,0,0,18" Visibility="{Binding HasNotes, Converter={StaticResource BoolVisibility}}"><TextBlock Text="备注" Style="{StaticResource Caption}" /><TextBlock x:Name="DetailNotes" Text="{Binding Notes}" /></StackPanel>
            <StackPanel Visibility="{Binding HasResumeNote, Converter={StaticResource BoolVisibility}}"><TextBlock Text="做到哪里 / 下一步" Style="{StaticResource Caption}" /><TextBlock Text="{Binding ResumeText}" /></StackPanel>
        </StackPanel></ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,20,0,0"><Button x:Name="EditButton" DockPanel.Dock="Left" Content="编辑" Click="Edit_Click" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="关闭" IsCancel="True" Margin="0,0,10,0" /><Button x:Name="FocusButton" Content="开始专注" Click="Focus_Click" Style="{StaticResource PrimaryButton}" /></StackPanel></DockPanel>
    </Grid>
</Window>
