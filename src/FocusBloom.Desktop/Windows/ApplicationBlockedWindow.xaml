<Window x:Class="FocusBloom.Desktop.Windows.ApplicationBlockedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在专注" Icon="{StaticResource BrandLogo}" Style="{StaticResource {x:Type Window}}"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">
    <Grid>
        <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{DynamicResource HeroStartColor}" /><GradientStop Color="{DynamicResource HeroEndColor}" Offset="1" /></LinearGradientBrush></Grid.Background>
        <Border Style="{StaticResource Card}" MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40">
            <StackPanel>
                <Image Source="{StaticResource BrandLogo}" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,24" />
                <TextBlock x:Name="ApplicationName" Text="此应用暂时不能操作" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="当前应用受本次规则限制，后台进程继续运行。" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,14,0,22" />
                <TextBlock Text="{Binding ActiveProjectName}" FontSize="18" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding TimerText}" FontFamily="{DynamicResource FocusTimerFont}" FontWeight="Light" Typography.NumeralAlignment="Tabular" FontSize="48" HorizontalAlignment="Center" Margin="0,12,0,8" />
                <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" />
                <WrapPanel HorizontalAlignment="Center" Margin="0,26,0,0">
                    <Button x:Name="ReturnToFocusButton" Content="返回专注" Click="ReturnToFocus_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" />
                    <Button Content="结束专注" Command="{Binding EndCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
