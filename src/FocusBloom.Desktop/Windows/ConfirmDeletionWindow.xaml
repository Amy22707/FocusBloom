<Window x:Class="FocusBloom.Desktop.Windows.ConfirmDeletionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认删除" Icon="{StaticResource BrandLogo}" Style="{StaticResource {x:Type Window}}"
        Width="430" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24">
        <TextBlock x:Name="DeletionHeading" Text="确认删除" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
        <TextBlock x:Name="DeletionMessage" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="CancelDeletionButton" Content="取消" IsDefault="True" IsCancel="True" Margin="0,0,10,0" />
            <Button x:Name="ConfirmDeletionButton" Content="删除" Click="Confirm_Click" Style="{StaticResource PrimaryButton}" />
            <Button x:Name="NoticeButton" Content="知道了" IsCancel="True" Visibility="Collapsed" />
        </StackPanel>
    </StackPanel>
</Window>
