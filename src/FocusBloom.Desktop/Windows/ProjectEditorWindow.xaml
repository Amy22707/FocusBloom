<Window x:Class="FocusBloom.Desktop.Windows.ProjectEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改项目" Icon="{StaticResource BrandLogo}" Style="{StaticResource {x:Type Window}}"
        Width="430" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24">
        <TextBlock x:Name="EditorHeading" Text="修改项目" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20" />
        <TextBlock Text="名称" Style="{StaticResource Caption}" />
        <TextBox x:Name="NameInput" />
        <StackPanel x:Name="FolderField" Margin="0,16,0,0">
            <TextBlock Text="所在文件夹" Style="{StaticResource Caption}" />
            <ComboBox x:Name="FolderSelector" DisplayMemberPath="Name" />
        </StackPanel>
        <TextBlock x:Name="DeleteHint" Text="删除后保留历史专注记录。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,18,0,0" />
        <TextBlock x:Name="ValidationMessage" Foreground="{DynamicResource AccentTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
        <DockPanel Margin="0,18,0,0">
            <Button x:Name="DeleteButton" Content="删除" Click="Delete_Click" DockPanel.Dock="Left" Padding="14,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" Padding="14,8" Margin="8,0,8,0" />
                <Button x:Name="SaveButton" Content="保存" Click="Save_Click" IsDefault="True" Style="{StaticResource PrimaryButton}" Padding="16,8" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
