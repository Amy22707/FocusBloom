<Window x:Class="FocusBloom.Desktop.Windows.TimerFloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:FocusBloom.Desktop.Views"
        Title="一刻专注 · 计时浮窗"
        Icon="{StaticResource BrandLogo}" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        Width="340" Height="244" MinWidth="240" MinHeight="180" MaxWidth="620" MaxHeight="420"
        ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual">
    <Window.Style><Style TargetType="Window" BasedOn="{StaticResource {x:Type Window}}">
        <Setter Property="Background" Value="Transparent" />
    </Style></Window.Style>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="18" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="FloatingMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Border x:Name="MenuSurface" CornerRadius="6" Padding="10,7" Background="Transparent">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="MenuCheck" Text="✓" Foreground="{DynamicResource AccentTextBrush}" Visibility="Collapsed" />
                        <ContentPresenter Grid.Column="1" ContentSource="Header" />
                    </Grid>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuSurface" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="MenuCheck" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FloatingText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource FocusTextFont}" />
            <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                <Condition Binding="{Binding TimerFloatUseBackground}" Value="True" /><Condition Binding="{Binding Media.HasBackground}" Value="True" />
            </MultiDataTrigger.Conditions><Setter Property="Foreground" Value="White" /></MultiDataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="FloatingCaption" TargetType="TextBlock" BasedOn="{StaticResource FloatingText}">
            <Setter Property="FontSize" Value="11" /><Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style x:Key="FloatingButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="9,6" /><Setter Property="FontSize" Value="11" />
            <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                <Condition Binding="{Binding TimerFloatUseBackground}" Value="True" /><Condition Binding="{Binding Media.HasBackground}" Value="True" />
            </MultiDataTrigger.Conditions><Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="#350D1826" /><Setter Property="BorderBrush" Value="#55FFFFFF" /><Setter Property="BorderThickness" Value="1" /></MultiDataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="FloatingIcon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="4" /><Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="12" /><Setter Property="FontFamily" Value="Segoe MDL2 Assets" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                <Condition Binding="{Binding TimerFloatUseBackground}" Value="True" /><Condition Binding="{Binding Media.HasBackground}" Value="True" />
            </MultiDataTrigger.Conditions><Setter Property="Foreground" Value="White" /></MultiDataTrigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Border x:Name="FloatSurface" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="18">
        <Border.Style><Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" /><Setter Property="BorderThickness" Value="1" />
            <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                <Condition Binding="{Binding TimerFloatUseBackground}" Value="True" /><Condition Binding="{Binding Media.HasBackground}" Value="True" />
            </MultiDataTrigger.Conditions><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="#101820" /></MultiDataTrigger></Style.Triggers>
        </Style></Border.Style>
        <Grid>
            <views:FocusBackgroundView x:Name="FloatBackground" DataContext="{Binding Media}" BackgroundImage="{Binding Background}" AnimatedUri="{Binding BackgroundGifUri}" VideoUri="{Binding BackgroundVideoUri}" CornerRadius="18" Visibility="{Binding DataContext.TimerFloatUseBackground, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" />
            <Border CornerRadius="18" Background="#6B0D1826">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding TimerFloatUseBackground}" Value="True" /><Condition Binding="{Binding Media.HasBackground}" Value="True" />
                </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Border.Style>
            </Border>
            <Grid Margin="12,10,12,10">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="OptionsButton" Content="&#xE713;" Click="Options_Click" Style="{StaticResource FloatingIcon}" ToolTip="浮窗设置：置顶、背景和透明度">
                            <Button.ContextMenu><ContextMenu Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextBrush}" Padding="6">
                                <MenuItem x:Name="PinItem" Header="置顶于其他窗口" Style="{StaticResource FloatingMenuItem}" IsCheckable="True" Click="Pin_Click" />
                                <Separator />
                                <MenuItem x:Name="SolidBackgroundItem" Header="纯色背景" Style="{StaticResource FloatingMenuItem}" IsCheckable="True" Click="SolidBackground_Click" />
                                <MenuItem x:Name="CurrentBackgroundItem" Header="当前计时背景" Style="{StaticResource FloatingMenuItem}" IsCheckable="True" Click="CurrentBackground_Click" />
                                <Separator />
                                <MenuItem StaysOpenOnClick="True" Focusable="False">
                                    <MenuItem.Template><ControlTemplate TargetType="MenuItem"><ContentPresenter ContentSource="Header" /></ControlTemplate></MenuItem.Template>
                                    <MenuItem.Header><StackPanel Width="180" Margin="10,6">
                                        <DockPanel><TextBlock Text="{Binding TimerFloatTransparency, StringFormat='{}{0:0}%'}" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="透明度" /></DockPanel>
                                        <Slider x:Name="TransparencySlider" Minimum="0" Maximum="70" Value="{Binding TimerFloatTransparency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,10,0,0" ToolTip="0% 不透明，70% 最透明" />
                                    </StackPanel></MenuItem.Header>
                                </MenuItem>
                            </ContextMenu></Button.ContextMenu>
                        </Button>
                        <Button x:Name="HideFloatButton" Content="&#xE8BB;" Click="Hide_Click" Style="{StaticResource FloatingIcon}" ToolTip="收起浮窗，继续计时" />
                    </StackPanel>
                    <Border x:Name="DragArea" Background="Transparent" MouseLeftButtonDown="DragArea_MouseLeftButtonDown" Cursor="SizeAll" ToolTip="拖动浮窗">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style><Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Hidden" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, ElementName=FloatSurface}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style></StackPanel.Style>
                            <Image Source="{StaticResource BrandLogo}" Width="19" Height="19" Margin="0,0,7,0" /><TextBlock Text="一刻专注" Style="{StaticResource FloatingCaption}" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DockPanel>
                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,6,0,8">
                    <StackPanel Width="280">
                        <TextBlock x:Name="FloatProject" Text="{Binding FocusHeading}" Style="{StaticResource FloatingText}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding FocusHeading}" />
                        <TextBlock Text="{Binding FocusTodoText}" Style="{StaticResource FloatingCaption}" FontSize="11" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Visibility="{Binding HasFocusTodo, Converter={StaticResource BoolVisibility}}" />
                        <TextBlock x:Name="FloatTimer" Text="{Binding TimerText}" Style="{StaticResource FloatingText}" FontFamily="{DynamicResource FocusTimerFont}" FontSize="52" FontWeight="Light" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" Margin="0,2" />
                        <TextBlock Text="{Binding StateText}" Style="{StaticResource FloatingText}" FontSize="12" TextAlignment="Center" />
                        <TextBlock x:Name="FloatPhase" Text="{Binding PhaseText}" Style="{StaticResource FloatingCaption}" FontSize="10" TextAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </Viewbox>
                <Grid x:Name="FloatActions" Grid.Row="2">
                    <Grid.Style><Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, ElementName=FloatSurface}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style></Grid.Style>
                    <Button x:Name="OpenMainButton" HorizontalAlignment="Right" Content="&#xE8A7;" Click="OpenMain_Click" Style="{StaticResource FloatingIcon}" ToolTip="返回主窗口" />
                    <StackPanel x:Name="FloatTimerActions" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="FloatStartButton" Content="开始" Command="{Binding StartCommand}" Style="{StaticResource FloatingButton}" Visibility="{Binding ShowStart, Converter={StaticResource BoolVisibility}}" />
                        <Button x:Name="FloatPauseButton" Content="暂停" Command="{Binding PauseCommand}" Style="{StaticResource FloatingButton}" Visibility="{Binding ShowPause, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,0" />
                        <Button x:Name="FloatResumeButton" Content="继续" Command="{Binding ResumeCommand}" Style="{StaticResource FloatingButton}" Visibility="{Binding ShowResume, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,0" />
                        <Button x:Name="FloatEndButton" Content="结束" Command="{Binding EndCommand}" Style="{StaticResource FloatingButton}" Visibility="{Binding ShowEnd, Converter={StaticResource BoolVisibility}}" />
                        <Button x:Name="FloatSkipRestButton" Content="跳过休息" Command="{Binding SkipRestCommand}" Style="{StaticResource FloatingButton}" Visibility="{Binding ShowSkipRest, Converter={StaticResource BoolVisibility}}" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
