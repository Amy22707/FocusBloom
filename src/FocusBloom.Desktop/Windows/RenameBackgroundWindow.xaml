<Window x:Class="FocusBloom.Desktop.Windows.RenameBackgroundWindow"
        xmlns:loc="clr-namespace:FocusBloom.Desktop.Presentation" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Translate '修改背景名称'}" Icon="{StaticResource BrandLogo}" Style="{StaticResource {x:Type Window}}"
        Width="430" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24">
        <TextBlock Text="{loc:Translate '修改背景名称'}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
        <TextBox x:Name="NameInput" />
        <TextBlock Text="{loc:Translate '只修改软件中的显示名称，原文件名保持不变。'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
        <TextBlock x:Name="ValidationMessage" Foreground="{DynamicResource AccentTextBrush}" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{loc:Translate '取消'}" IsCancel="True" Margin="0,0,10,0" />
            <Button x:Name="SaveNameButton" Content="{loc:Translate '保存'}" IsDefault="True" Click="Save_Click" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </StackPanel>
</Window>
