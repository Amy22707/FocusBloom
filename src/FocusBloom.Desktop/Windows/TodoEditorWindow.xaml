<Window x:Class="FocusBloom.Desktop.Windows.TodoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑待办" Style="{StaticResource {x:Type Window}}" Width="560" Height="640" MinWidth="460" MinHeight="460" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock x:Name="EditorHeading" Text="待办事项" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,18" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="名称" Style="{StaticResource Caption}" /><TextBox x:Name="TitleInput" Margin="0,0,0,14" />
            <TextBlock Text="文件夹" Style="{StaticResource Caption}" /><ComboBox x:Name="FolderSelector" DisplayMemberPath="Label" Margin="0,0,0,14" />
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="状态" Style="{StaticResource Caption}" /><ComboBox x:Name="StatusSelector" DisplayMemberPath="Name" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="优先级" Style="{StaticResource Caption}" /><ComboBox x:Name="PrioritySelector" DisplayMemberPath="Name" /></StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14"><CheckBox x:Name="ImportantInput" Content="重要" Margin="0,0,26,0" /><CheckBox x:Name="UrgentInput" Content="紧急" /></StackPanel>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="截止日期（可选）" Style="{StaticResource Caption}" /><DatePicker x:Name="DueDateInput" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="时间 / HH:mm（可选）" Style="{StaticResource Caption}" /><TextBox x:Name="DueTimeInput" /></StackPanel>
            </Grid>
            <TextBlock Text="预计投入 / 分钟（可选）" Style="{StaticResource Caption}" /><TextBox x:Name="EstimateInput" Margin="0,0,0,14" />
            <TextBlock Text="备注" Style="{StaticResource Caption}" /><TextBox x:Name="NotesInput" AcceptsReturn="True" TextWrapping="Wrap" Height="85" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14" />
            <TextBlock Text="做到哪里 / 下一步" Style="{StaticResource Caption}" /><TextBox x:Name="ResumeInput" AcceptsReturn="True" TextWrapping="Wrap" Height="72" VerticalScrollBarVisibility="Auto" />
            <StackPanel x:Name="ReminderArea" Margin="0,16,0,0" />
            <TextBlock x:Name="ValidationMessage" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel></ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,20,0,0"><Button x:Name="DeleteButton" Content="删除" Click="Delete_Click" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Margin="0,0,12,0" /><Button x:Name="SaveButton" Content="保存" Click="Save_Click" IsDefault="True" Style="{StaticResource PrimaryButton}" /></StackPanel>
        </DockPanel>
    </Grid>
</Window>
