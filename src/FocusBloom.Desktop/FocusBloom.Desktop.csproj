<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>FocusBloom</AssemblyName>
    <ApplicationIcon>Resources/Branding/FocusBloom.ico</ApplicationIcon>
    <IncludePackageReferencesDuringMarkupCompilation>false</IncludePackageReferencesDuringMarkupCompilation>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OfflineRelease)' == 'true'">
    <DefineConstants>$(DefineConstants);FOCUSBLOOM_OFFLINE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FocusBloom.Tests" />
    <Content Include="../../cloudbase.local.json" Link="cloud-config.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="'$(OfflineRelease)' != 'true' And '$(IncludeLocalCloudConfig)' != 'false' And Exists('../../cloudbase.local.json')" />
    <Resource Include="Resources/Branding/FocusBloom.png" />
    <Resource Include="Resources/Branding/FocusBloom.ico" />
    <EmbeddedResource Include="Resources/English.json" LogicalName="FocusBloom.English.json" />
    <Content Include="Resources/Focus/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Resources/ThirdParty/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../FocusBloom.Core/FocusBloom.Core.csproj" />
    <ProjectReference Include="../FocusBloom.Infrastructure/FocusBloom.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="XamlAnimatedGif" Version="2.3.2" />
  </ItemGroup>
</Project>
