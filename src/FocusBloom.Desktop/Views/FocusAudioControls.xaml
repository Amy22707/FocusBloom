<UserControl x:Class="FocusBloom.Desktop.Views.FocusAudioControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Visibility="{Binding ShowLibrary, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisibility}}">
            <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="导入音频" Click="ImportSound_Click" Padding="10,4" FontSize="11" HorizontalAlignment="Right" /><TextBlock Text="声音" FontSize="15" FontWeight="SemiBold" /></DockPanel>
            <ListBox x:Name="SoundSelector" ItemsSource="{Binding QuickSounds}" SelectedItem="{Binding SelectedSound}" DisplayMemberPath="Name" ScrollViewer.CanContentScroll="False" MaxHeight="160">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource FolderItem}">
                    <Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="10,8" />
                </Style></ListBox.ItemContainerStyle>
            </ListBox>
        </StackPanel>
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="AudioToggleButton" Content="{Binding AudioButtonText}" Command="{Binding ToggleAudioCommand}" Padding="10,6" FontSize="11" />
            <Slider Grid.Column="1" Value="{Binding Volume}" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="10,0" ToolTip="音量" />
            <CheckBox Grid.Column="2" Content="静音" IsChecked="{Binding Muted}" VerticalAlignment="Center" FontSize="11" />
        </Grid>
        <TextBlock Text="{Binding SelectedSound.Name}" FontSize="12" Margin="0,10,0,0" />
        <TextBlock Text="{Binding SoundCredit}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
    </StackPanel>
</UserControl>
