<UserControl x:Class="FocusBloom.Desktop.Views.PomodoroSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="专注 / 分钟" Style="{StaticResource Caption}" />
        <TextBox x:Name="FocusMinutesInput" Text="{Binding PomodoroFocusMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="短休息 / 分钟" Style="{StaticResource Caption}" /><TextBox Text="{Binding PomodoroShortRestMinutes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="长休息 / 分钟" Style="{StaticResource Caption}" /><TextBox Text="{Binding PomodoroLongRestMinutes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="每几轮长休息" Style="{StaticResource Caption}" /><TextBox Text="{Binding PomodoroLongRestEvery, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="总轮数" Style="{StaticResource Caption}" /><TextBox Text="{Binding PomodoroRounds, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
        </Grid>
        <TextBlock Text="休息后自动进入下一轮，最后一轮结束后停止。休息可跳过，也可随时结束循环。" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="19" Margin="0,12,0,0" />
    </StackPanel>
</UserControl>
