<UserControl x:Class="FocusBloom.Desktop.Views.DateEventsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:present="clr-namespace:FocusBloom.Desktop.Presentation" xmlns:vm="clr-namespace:FocusBloom.Desktop.ViewModels">
    <UserControl.Resources>
        <Style x:Key="GroupFilterToggle" TargetType="ToggleButton"><Setter Property="Background" Value="{DynamicResource FieldBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="12,7" /><Setter Property="Cursor" Value="Hand" /><Setter Property="MinHeight" Value="36" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <DataTemplate x:Key="DateItemCard"><Button present:GroupDragDrop.Source="True" Click="Edit_Click" Padding="0" Background="Transparent" Margin="0,0,12,12" HorizontalContentAlignment="Stretch">
                <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                <Border LayoutTransform="{DynamicResource DateEventCardTransform}" Height="150" CornerRadius="18" Padding="18" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><Grid>
                    <Border CornerRadius="16" Margin="-18"><Border.Background><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" /></Border.Background></Border>
                    <Border Background="#66000000" CornerRadius="16" Margin="-18" Visibility="{Binding HasCover, Converter={StaticResource BoolVisibility}}" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Style.Triggers><DataTrigger Binding="{Binding HasCover}" Value="True"><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Grid.Row="1" Text="{Binding Item.Group}" FontSize="11" Margin="0,4,0,0" Visibility="{Binding DataContext.ShowMixedGroups, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolVisibility}}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding HasCover}" Value="True"><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Grid.Row="2" Text="{Binding Notes}" FontSize="12" Margin="0,8,0,0" MaxHeight="32" LineHeight="16" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding HasCover}" Value="True"><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <TextBlock Grid.Row="3" Text="{Binding Detail}" FontSize="11" Margin="0,10,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding HasCover}" Value="True"><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontSize="12" /><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Number}" FontSize="38" FontWeight="Light" /><TextBlock Text="天" FontSize="12" VerticalAlignment="Bottom" Margin="4,0,0,8" /></StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" /><Style.Triggers><DataTrigger Binding="{Binding HasCover}" Value="True"><Setter Property="TextElement.Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></StackPanel.Style></StackPanel>
                    </Grid>
                </Grid></Border>
            </Button></DataTemplate>
        <DataTemplate x:Key="BoardDateCard"><Button present:GroupDragDrop.Source="True" Click="Edit_Click" Style="{StaticResource CompletionDateButton}" Margin="0,0,0,10" ToolTip="{Binding Title}"><Border LayoutTransform="{DynamicResource DateEventCardTransform}" Height="108" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><Grid>
            <Border CornerRadius="11"><Border.Background><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" /></Border.Background></Border><Border Background="#88000000" CornerRadius="11" Visibility="{Binding HasCover, Converter={StaticResource BoolVisibility}}" />
            <Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Style.Triggers><DataTrigger Binding="{Binding HasCover}" Value="True"><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,8,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding HasCover}" Value="True"><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" /><Style.Triggers><DataTrigger Binding="{Binding HasCover}" Value="True"><Setter Property="TextElement.Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{Binding Label}" FontSize="10" HorizontalAlignment="Right" /><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Number}" FontSize="28" FontWeight="Light" /><TextBlock Text="天" FontSize="10" VerticalAlignment="Bottom" Margin="3,0,0,5" /></StackPanel></StackPanel>
            </Grid>
        </Grid></Border></Button></DataTemplate>
    </UserControl.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="NewDateGroupButton" Content="新建分组" Click="NewGroup_Click" Margin="0,0,8,0" FontSize="12" /><Button x:Name="NewDateEventButton" Content="＋ 新建日期事项" Click="New_Click" Style="{StaticResource PrimaryButton}" FontSize="12" /></StackPanel><StackPanel><TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitle}" /><TextBlock Text="{Binding Summary}" Style="{StaticResource PageSubtitle}" /></StackPanel></DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,14" LastChildFill="False"><TextBlock Text="显示范围" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" /><ComboBox x:Name="DateGroupScopeSelector" Width="200" HorizontalAlignment="Left" ItemsSource="{Binding GroupChoices}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedGroup}" /><Button Content="管理当前分组" Click="EditSelectedGroup_Click" HorizontalAlignment="Left" Margin="10,0,0,0" FontSize="12" Visibility="{Binding ShowSingleGroup, Converter={StaticResource BoolVisibility}}" /><CheckBox x:Name="MixedDatesToggle" Content="混合查看" IsChecked="{Binding MixedView}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12" Visibility="{Binding ShowAllGroups, Converter={StaticResource BoolVisibility}}" />
            <ToggleButton x:Name="MixedGroupsToggle" Style="{StaticResource GroupFilterToggle}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding ShowMixedGroups, Converter={StaticResource BoolVisibility}}" ToolTip="选择混合显示的分组"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding MixedGroupSummary}" /><TextBlock Text="⌄" Margin="10,0,0,0" Foreground="{DynamicResource MutedBrush}" /></StackPanel></ToggleButton>
            <Popup PlacementTarget="{Binding ElementName=MixedGroupsToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=MixedGroupsToggle, Mode=TwoWay}"><Border Padding="14" Width="220" Margin="0,5,0,0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><StackPanel><TextBlock Text="选择参与混合查看的分组" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10" /><ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="MixedGroupFilters" ItemsSource="{Binding GroupFilters}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Margin="0,5" FontSize="12" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Border></Popup></DockPanel>
        <ScrollViewer x:Name="DateCardsViewport" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding ShowCards, Converter={StaticResource BoolVisibility}}"><ItemsControl x:Name="DateCards" ItemsSource="{Binding VisibleItems}" ItemTemplate="{StaticResource DateItemCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{DynamicResource DateEventCardColumns}" VerticalAlignment="Top" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer>
        <ScrollViewer x:Name="DateBoardViewport" Grid.Row="2" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" CanContentScroll="False" Visibility="{Binding ShowBoard, Converter={StaticResource BoolVisibility}}"><ItemsControl x:Name="DateGroupBoard" present:ReorderButton.EnableDrop="True" ItemsSource="{Binding Groups}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
            <Border present:GroupDragDrop.AcceptType="{x:Type vm:DateEventRow}" present:GroupDragDrop.MoveRequested="GroupMove_Requested" Width="280" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Padding="12" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Margin="0,0,12,0"><DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="2,0,2,14"><Button Content="···" DockPanel.Dock="Right" Click="EditGroup_Click" Style="{StaticResource QuietTool}" Padding="5,0" ToolTip="修改或删除分组" Visibility="{Binding Editable, Converter={StaticResource BoolVisibility}}" /><Button Content="＋" DockPanel.Dock="Right" Click="NewInGroup_Click" Style="{StaticResource QuietTool}" FontSize="18" Padding="5,0" ToolTip="在此分组添加日期事项" /><present:ReorderButton DockPanel.Dock="Right" ReorderRequested="GroupOrder_Requested" ToolTip="拖动调整分组顺序" VerticalAlignment="Center" /><TextBlock Text="{Binding CountText}" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0" /><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></DockPanel>
                <Grid><ScrollViewer Tag="{Binding Name}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource BoardDateCard}" /></ScrollViewer><TextBlock Text="这个组还没有日期事项" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" /></Grid>
            </DockPanel></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <TextBlock Grid.Row="2" Text="{Binding EmptyMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ShowCards}" Value="True" /><Condition Binding="{Binding IsEmpty}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
</UserControl>
