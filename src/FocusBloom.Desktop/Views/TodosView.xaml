<UserControl x:Class="FocusBloom.Desktop.Views.TodosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:present="clr-namespace:FocusBloom.Desktop.Presentation">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20" Visibility="{Binding ShowList, Converter={StaticResource BoolVisibility}}"><Button x:Name="NewTodoButton" DockPanel.Dock="Right" Content="＋ 新建待办" Click="NewTodo_Click" Style="{StaticResource PrimaryButton}" />
            <StackPanel><TextBlock Text="把下一件事，写下来" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="待办整理事项，专注记录投入。完成状态由你决定。" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" /></StackPanel>
        </DockPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions>
            <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="205" /><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=TodoSidebarToggle}" Value="True"><Setter Property="Width" Value="0" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
            <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="18" /><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=TodoSidebarToggle}" Value="True"><Setter Property="Width" Value="0" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
            <ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border x:Name="TodoCategoriesPane" Padding="14,18"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=TodoSidebarToggle}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style><DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="我的文件夹" FontWeight="SemiBold" FontSize="16" Margin="4,0,4,16" />
                <Button DockPanel.Dock="Bottom" Content="＋ 新建文件夹" Click="NewFolder_Click" Padding="10,8" FontSize="12" Margin="0,10,0,0" />
                <ListBox x:Name="TodoFolderList" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" ItemContainerStyle="{StaticResource FolderItem}" present:ReorderButton.EnableDrop="True">
                    <ListBox.ItemTemplate><DataTemplate><DockPanel>
                        <Button DockPanel.Dock="Right" Content="···" Click="EditFolder_Click" Padding="5,1" Background="Transparent" ToolTip="修改或删除文件夹" />
                        <present:ReorderButton DockPanel.Dock="Right" ReorderRequested="FolderOrder_Requested" />
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
                    </DockPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel></Border>
            <Border x:Name="TodoContentCard" Grid.Column="2" Style="{StaticResource Card}" Padding="14"><Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,16"><ComboBox x:Name="TodoViewSelector" DockPanel.Dock="Right" Width="110" ItemsSource="{Binding ViewModes}" SelectedItem="{Binding ViewMode}" Margin="12,0,0,0" VerticalAlignment="Center" /><ToggleButton x:Name="TodoSidebarToggle" DockPanel.Dock="Left" Style="{StaticResource SidebarToggle}" ToolTip="展开或收起文件夹" Margin="0,0,12,0" VerticalAlignment="Center" /><StackPanel><TextBlock Text="{Binding Heading}" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,0" /></StackPanel></DockPanel>
                <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="110" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="按名称或备注搜索" /><ComboBox Grid.Column="2" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" />
                    <ComboBox x:Name="QuadrantScopeSelector" Grid.Column="3" ItemsSource="{Binding QuadrantScopes}" SelectedItem="{Binding QuadrantScope}" Width="132" Margin="12,0,0,0" ToolTip="四象限显示范围" Visibility="{Binding ShowQuadrants, Converter={StaticResource BoolVisibility}}" />
                </Grid>
                <ListBox x:Name="TodoList" Grid.Row="2" ItemsSource="{Binding VisibleItems}" ScrollViewer.CanContentScroll="False" HorizontalContentAlignment="Stretch" present:ReorderButton.EnableDrop="True" Visibility="{Binding ShowList, Converter={StaticResource BoolVisibility}}">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource FolderItem}"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,8,8" /><Setter Property="Height" Value="120" /><Setter Property="VerticalAlignment" Value="Top" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" VerticalAlignment="Top" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate><DataTemplate><Border Height="120" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Completed, Mode=OneWay}" Click="Complete_Click" ToolTip="标记完成或恢复待办" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <Button x:Name="OpenListTodoDetailsButton" Grid.Column="1" Click="TodoDetails_Click" Padding="0" Background="Transparent" ToolTip="{Binding Title}">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Completed}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough" /><Setter Property="Opacity" Value="0.55" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="ListDeadline" Grid.Row="1" Text="{Binding DueText}" Margin="0,7,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding DueText}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding HasDueDate}" Value="True"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger><DataTrigger Binding="{Binding Overdue}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /><Setter Property="FontWeight" Value="Bold" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="{DynamicResource AccentTextBrush}" FontSize="10" Margin="0,5,0,0" />
                            <DockPanel Grid.Row="3"><Button DockPanel.Dock="Right" Content="···" Click="EditTodo_Click" Background="Transparent" Padding="5,0" ToolTip="编辑、移动或删除待办" /><present:ReorderButton DockPanel.Dock="Right" ReorderRequested="ItemOrder_Requested" /><Button Content="详情 ↗" Click="TodoDetails_Click" Padding="0" Background="Transparent" FontSize="10" HorizontalAlignment="Left" /></DockPanel>
                        </Grid>
                    </Border></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <ScrollViewer x:Name="QuadrantViewport" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding ShowQuadrants, Converter={StaticResource BoolVisibility}}">
                    <Grid x:Name="QuadrantPlane" MinHeight="280" Height="{Binding ActualHeight, ElementName=QuadrantViewport}">
                        <Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition Height="*" /><RowDefinition Height="1" /><RowDefinition Height="*" /><RowDefinition Height="12" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /></Grid.ColumnDefinitions>
                        <ItemsControl x:Name="QuadrantBoard" Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="3" ItemsSource="{Binding Quadrants}" SizeChanged="QuadrantBoard_SizeChanged">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid><Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions></Grid></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Grid.Row" Value="{Binding Row}" /><Setter Property="Grid.Column" Value="{Binding Column}" /></Style></ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate><DataTemplate><Border Margin="12,8" Padding="4">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="＋" Click="NewQuadrantTodo_Click" Padding="4,0" Background="Transparent" FontSize="18" ToolTip="在这个象限新建待办" /><TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="{Binding Title}" ToolTip="{Binding Hint}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="QuadrantScroll_PreviewMouseWheel">
                                    <ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Height="32" Padding="8,0" Margin="0,0,0,4">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding Completed, Mode=OneWay}" Click="Complete_Click" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="标记完成或恢复待办" />
                                            <Button x:Name="OpenTodoDetailsButton" Grid.Column="1" Click="TodoDetails_Click" Background="Transparent" Padding="0" ToolTip="{Binding Title}">
                                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="QuadrantTodoTitle" Text="{Binding Title}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Completed}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough" /><Setter Property="Opacity" Value="0.55" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                    <TextBlock x:Name="QuadrantDeadline" Grid.Column="1" Text="{Binding DueCompactText}" FontSize="10" FontWeight="SemiBold" TextWrapping="NoWrap" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding DueText}" Visibility="{Binding HasDueDate, Converter={StaticResource BoolVisibility}}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Overdue}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /><Setter Property="FontWeight" Value="Bold" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                </Grid>
                                            </Button>
                                        </Grid>
                                    </Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </ScrollViewer>
                                <TextBlock Grid.Row="1" Text="点击 ＋ 添加事项" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" />
                            </Grid>
                        </Border></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Path x:Name="QuadrantAxes" Grid.RowSpan="5" Grid.ColumnSpan="4" Stroke="{DynamicResource MutedBrush}" Fill="{DynamicResource MutedBrush}" StrokeThickness="1" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.6" IsHitTestVisible="False" />
                        <TextBlock Grid.Column="2" Text="紧急" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Bottom" Margin="9,0,0,2" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="重要" Foreground="{DynamicResource MutedBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,6" />
                    </Grid>
                </ScrollViewer>
                <TextBlock Grid.Row="2" Text="这里还没有符合条件的待办，点击“新建待办”添加。" Foreground="{DynamicResource MutedBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsEmpty}" Value="True" /><Condition Binding="{Binding ShowList}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </Grid></Border>
        </Grid>
    </Grid>
</UserControl>
