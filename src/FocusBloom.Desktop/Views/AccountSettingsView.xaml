<UserControl x:Class="FocusBloom.Desktop.Views.AccountSettingsView" xmlns:loc="clr-namespace:FocusBloom.Desktop.Presentation" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><Style x:Key="LoginMode" TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Margin" Value="0,0,10,0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Surface" Background="{DynamicResource SubtleBrush}" CornerRadius="16" Padding="15,9" Cursor="Hand"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></UserControl.Resources>
    <StackPanel TextElement.Foreground="{DynamicResource TextBrush}">
        <StackPanel x:Name="SignedInPanel" Visibility="{Binding SignedIn, Converter={StaticResource BoolVisibility}}">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid Width="60" Height="60" HorizontalAlignment="Left">
                    <Ellipse Fill="{DynamicResource SelectedBrush}" /><TextBlock Text="{Binding AvatarInitial}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding Avatar}" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30" /></Image.Clip></Image>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding AccountText, Converter={StaticResource UiTextConverter}}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,0" /></StackPanel>
                <Button Grid.Column="2" Content="{loc:Translate '编辑资料'}" Command="{Binding EditProfileCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
            <Border x:Name="ProfileEditor" Visibility="{Binding EditingProfile, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SubtleBrush}" CornerRadius="20" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{loc:Translate '个人资料'}" FontSize="16" FontWeight="SemiBold" />
                    <DockPanel Margin="0,16,0,16">
                        <Grid Width="64" Height="64" DockPanel.Dock="Left" Margin="0,0,16,0"><Ellipse Fill="{DynamicResource SelectedBrush}" /><TextBlock Text="{Binding AvatarInitial}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" /><Image Source="{Binding AvatarPreview}" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="32,32" RadiusX="32" RadiusY="32" /></Image.Clip></Image></Grid>
                        <WrapPanel VerticalAlignment="Center"><Button Content="{loc:Translate '更换头像'}" Command="{Binding ChooseAvatarCommand}" Margin="0,0,8,0" /><Button Content="{loc:Translate '使用默认头像'}" Command="{Binding ClearAvatarCommand}" /></WrapPanel>
                    </DockPanel>
                    <TextBlock Text="{loc:Translate '姓名或昵称'}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,7" />
                    <TextBox x:Name="ProfileNameInput" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" MaxLength="48" />
                    <WrapPanel Margin="0,16,0,0"><Button Content="{loc:Translate '保存资料'}" Command="{Binding SaveProfileCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" /><Button Content="{loc:Translate '取消'}" Command="{Binding CancelProfileCommand}" /></WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="{loc:Translate '数据同步'}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Translate '专注记录、项目、网站规则与通用计时偏好在设备间同步。'}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,12" />
            <TextBlock Text="{loc:Translate '每周检查一次云端；本机修改合并后自动同步，也可以随时手动同步。'}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,12" />
            <DockPanel><Button DockPanel.Dock="Right" Content="{loc:Translate '立即同步'}" Command="{Binding SyncCommand}" Margin="12,0,0,0" /><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding PendingText}" FontSize="12" /><TextBlock Text="{Binding LastSync}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" /></StackPanel></DockPanel>
            <Expander x:Name="PasswordSection" Header="{Binding PasswordHeading, Converter={StaticResource UiTextConverter}}" Foreground="{DynamicResource TextBrush}" Margin="0,20,0,0"><StackPanel Margin="0,12,0,0">
                <TextBlock Text="{loc:Translate '验证当前邮箱后，设置或修改登录密码。'}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,14" />
                <StackPanel Visibility="{Binding HasPassword, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{loc:Translate '原密码'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7" /><PasswordBox x:Name="OldPasswordInput" PasswordChanged="OldPassword_Changed" MaxLength="64" Margin="0,0,0,14" /></StackPanel>
                <TextBlock Text="{loc:Translate '新密码'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7" /><PasswordBox x:Name="NewPasswordInput" PasswordChanged="NewPassword_Changed" MaxLength="64" />
                <TextBlock Text="{loc:Translate '8至64位，包含大小写字母、数字和符号。'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,14" />
                <TextBlock Text="{loc:Translate '确认新密码'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7" /><PasswordBox x:Name="ConfirmPasswordInput" PasswordChanged="ConfirmPassword_Changed" MaxLength="64" />
                <TextBlock Text="{loc:Translate '邮箱验证码'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,7" /><DockPanel><Button DockPanel.Dock="Right" Content="{Binding SendPasswordCodeText, Converter={StaticResource UiTextConverter}}" Command="{Binding SendPasswordCodeCommand}" Margin="10,0,0,0" /><TextBox Text="{Binding PasswordCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" /></DockPanel>
                <Button Content="{Binding PasswordHeading, Converter={StaticResource UiTextConverter}}" Command="{Binding SetPasswordCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" />
            </StackPanel></Expander>
            <Expander Header="{loc:Translate '本机数据'}" Foreground="{DynamicResource TextBrush}" Margin="0,20,0,18"><StackPanel Margin="0,12,0,0"><TextBlock Text="{loc:Translate '将访客的全部已保存内容并入当前账号，保留账号已有条目，并应用原有字体、素材和界面偏好。导入前自动备份，完成后重新打开软件。'}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" /><Button Content="{loc:Translate '导入本机原有数据'}" Command="{Binding ImportGuestCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" /></StackPanel></Expander>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0"><DockPanel><Button x:Name="SignOutButton" DockPanel.Dock="Right" Content="{loc:Translate '退出登录'}" Command="{Binding SignOutCommand}" Margin="16,0,0,0" /><StackPanel><TextBlock Text="{loc:Translate '登录管理'}" FontWeight="SemiBold" /><TextBlock Text="{loc:Translate '退出后可切换账号，本机已保存的数据会保留。'}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" /></StackPanel></DockPanel></Border>
        </StackPanel>
        <StackPanel x:Name="GuestLoginPanel" Visibility="{Binding IsGuest, Converter={StaticResource BoolVisibility}}">
            <TextBlock x:Name="ExpiredLoginNotice" Text="{Binding LoginHeading, Converter={StaticResource UiTextConverter}}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding LoginDescription, Converter={StaticResource UiTextConverter}}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,22" />
            <WrapPanel Margin="0,0,0,20"><RadioButton Content="{loc:Translate '验证码登录'}" GroupName="LoginMethod" Style="{StaticResource LoginMode}" IsChecked="{Binding UseCodeLogin, Mode=OneWay}" Checked="UseCode_Click" /><RadioButton Content="{loc:Translate '密码登录'}" GroupName="LoginMethod" Style="{StaticResource LoginMode}" IsChecked="{Binding UsePasswordLogin, Mode=TwoWay}" /></WrapPanel>
            <TextBlock Text="{loc:Translate '邮箱'}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,7" /><TextBox x:Name="AccountEmailInput" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Visibility="{Binding ShowVerification, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{loc:Translate '验证码'}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,16,0,7" /><DockPanel><Button DockPanel.Dock="Right" Content="{Binding SendCodeText, Converter={StaticResource UiTextConverter}}" Command="{Binding SendCodeCommand}" Margin="10,0,0,0" /><TextBox x:Name="AccountCodeInput" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" ToolTip="{loc:Translate '6位邮箱验证码'}" /></DockPanel></StackPanel>
            <StackPanel Visibility="{Binding UsePasswordLogin, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{loc:Translate '密码'}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,16,0,7" /><PasswordBox x:Name="LoginPasswordInput" PasswordChanged="LoginPassword_Changed" MaxLength="64" /><Button Content="{loc:Translate '忘记密码？'}" Click="RecoverPassword_Click" HorizontalAlignment="Left" FontSize="12" Margin="0,8,0,0" /></StackPanel>
            <StackPanel Visibility="{Binding RecoveringPassword, Converter={StaticResource BoolVisibility}}" Margin="0,14,0,0">
                <TextBlock Text="{loc:Translate '新密码（8至64位，含大小写字母、数字和符号）'}" Margin="0,0,0,7" />
                <PasswordBox x:Name="RecoveryPasswordInput" PasswordChanged="NewPassword_Changed" MaxLength="64" />
                <TextBlock Text="{loc:Translate '确认新密码'}" Margin="0,12,0,7" />
                <PasswordBox x:Name="RecoveryConfirmInput" PasswordChanged="ConfirmPassword_Changed" MaxLength="64" />
                <Button Content="{loc:Translate '重置密码'}" Command="{Binding ResetPasswordCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" />
            </StackPanel>
            <CheckBox Content="{loc:Translate '合并本机访客的全部已保存内容与偏好'}" IsChecked="{Binding MergeGuest}" Margin="0,18,0,14" Visibility="{Binding CanMergeGuest, Converter={StaticResource BoolVisibility}}" />
            <Button Content="{loc:Translate '登录 / 注册'}" Command="{Binding SignInCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Visibility="{Binding UseCodeLogin, Converter={StaticResource BoolVisibility}}" />
            <Button Content="{loc:Translate '登录'}" Command="{Binding PasswordLoginCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Visibility="{Binding UsePasswordLogin, Converter={StaticResource BoolVisibility}}" />
            <TextBlock Text="{Binding LoginFootnote, Converter={StaticResource UiTextConverter}}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding Status, Converter={StaticResource UiTextConverter}}" TextWrapping="Wrap" Foreground="{DynamicResource AccentTextBrush}" FontSize="12" Margin="0,16,0,0" />
        <ItemsControl ItemsSource="{Binding Conflicts}" Margin="0,18,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel>
            <TextBlock Text="{Binding Heading, Converter={StaticResource UiTextConverter}}" FontWeight="SemiBold" /><TextBlock Text="{Binding Local}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,5" /><TextBlock Text="{Binding Cloud}" TextWrapping="Wrap" FontSize="12" />
            <WrapPanel Margin="0,10,0,0"><Button Content="{loc:Translate '保留本机'}" Command="{Binding KeepLocalCommand}" Margin="0,0,8,0" /><Button Content="{loc:Translate '采用云端'}" Command="{Binding UseCloudCommand}" /></WrapPanel>
        </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
</UserControl>
