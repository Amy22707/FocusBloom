<UserControl x:Class="FocusBloom.Desktop.Views.FocusMediaSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusBloom.Desktop.Views"
        xmlns:present="clr-namespace:FocusBloom.Desktop.Presentation">
    <UserControl.Resources>
        <Style x:Key="MaterialOriginBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="8,4" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="Margin" Value="0,0,0,10" />
            <Style.Triggers><DataTrigger Binding="{Binding Custom}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="LibraryCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="14" /><Setter Property="Margin" Value="0,0,12,12" />
            <Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Background" Value="{DynamicResource SelectedBrush}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="LibraryToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="{DynamicResource SubtleBrush}" /><Setter Property="Padding" Value="14,8" /><Setter Property="FontSize" Value="12" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="LibraryExpander" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <StackPanel>
                    <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" HorizontalContentAlignment="Stretch" Foreground="{DynamicResource TextBrush}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border Background="{DynamicResource SubtleBrush}" CornerRadius="12" Padding="16,12" Cursor="Hand">
                                <DockPanel><TextBlock x:Name="Arrow" DockPanel.Dock="Right" Text="＋" FontSize="18" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="16,0,0,0" /><ContentPresenter /></DockPanel>
                            </Border>
                            <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="－" /></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter x:Name="Details" Visibility="Collapsed" Margin="0,16,0,0" />
                </StackPanel>
                <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{present:Translate '专注期间更换的素材将在下一次专注时使用。'}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,14" />
        <Expander x:Name="BackgroundLibrary" IsExpanded="False" Style="{StaticResource LibraryExpander}">
            <Expander.Header><StackPanel><TextBlock Text="{present:Translate '背景'}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedBackground.Name}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" /></StackPanel></Expander.Header>

                <StackPanel>
                    <WrapPanel Margin="0,0,0,12"><ToggleButton Content="{present:Translate '每次随机'}" IsChecked="{Binding BackgroundRandom, Mode=OneWay}" Click="RandomBackground_Click" Style="{StaticResource LibraryToggle}" Margin="0,0,10,0" /><ToggleButton Content="{present:Translate '纯色背景'}" IsChecked="{Binding BackgroundPlain, Mode=OneWay}" Click="PlainBackground_Click" Style="{StaticResource LibraryToggle}" /><CheckBox Content="{present:Translate '随机时只选收藏'}" IsChecked="{Binding FavoritesOnly}" VerticalAlignment="Center" Margin="16,0,0,0" /></WrapPanel>
                    <DockPanel Margin="0,0,0,12"><CheckBox DockPanel.Dock="Right" Content="{present:Translate '只看收藏'}" IsChecked="{Binding ShowFavoriteImages}" VerticalAlignment="Center" /><WrapPanel><Button Content="{present:Translate '添加背景'}" Click="ImportImages_Click" Padding="12,7" Margin="0,0,8,0" /><Button Content="{present:Translate '添加文件夹'}" Click="ImportFolder_Click" Padding="12,7" Margin="0,0,8,0" /><Button Content="{present:Translate '恢复默认'}" Click="RestoreImages_Click" Padding="12,7" /></WrapPanel></DockPanel>

                        <ItemsControl x:Name="BackgroundCards" present:ReorderButton.EnableDrop="True" ItemsSource="{Binding VisibleImages}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                            <Border Width="180" LayoutTransform="{DynamicResource MediaCardTransform}" Style="{StaticResource LibraryCard}"><StackPanel>
                                <DockPanel><present:ReorderButton DockPanel.Dock="Right" ReorderRequested="MediaOrder_Requested" Margin="4,0,0,8" /><TextBlock DockPanel.Dock="Right" Text="{Binding FormatLabel}" FontSize="10" Foreground="{DynamicResource AccentTextBrush}" Margin="8,0,0,10" VerticalAlignment="Center" Visibility="{Binding IsDynamic, Converter={StaticResource BoolVisibility}}" /><Border Style="{StaticResource MaterialOriginBadge}"><TextBlock Text="{Binding Origin}" FontSize="10" Foreground="{DynamicResource TextBrush}" /></Border></DockPanel>
                                <Border Height="85" CornerRadius="8" Background="{DynamicResource SubtleBrush}"><Grid>
                                    <Border CornerRadius="8"><Border.Background><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" /></Border.Background></Border>
                                    <TextBlock Text="{Binding ThumbnailStatus}" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border Background="#990D1826" CornerRadius="5" Padding="5" Margin="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding IsVideo, Converter={StaticResource BoolVisibility}}"><TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" /></Border>
                                </Grid></Border>
                                <DockPanel Margin="0,10,0,5">
                                    <Button DockPanel.Dock="Right" Content="{present:Translate '改名'}" Click="RenameImage_Click" Visibility="{Binding Custom, Converter={StaticResource BoolVisibility}}" Padding="5,2" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding Credit}" FontSize="9" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="{present:Translate '使用'}" Click="UseImage_Click" Padding="8,5" FontSize="11" Margin="0,0,6,0" /><CheckBox Content="{present:Translate '收藏'}" IsChecked="{Binding Favorite}" VerticalAlignment="Center" FontSize="11" /><Button Content="{present:Translate '删除'}" Click="RemoveImage_Click" Visibility="{Binding Custom, Converter={StaticResource BoolVisibility}}" Padding="6,5" FontSize="11" Margin="4,0,0,0" /></StackPanel>
                                <CheckBox Content="{present:Translate '不参与随机'}" IsChecked="{Binding Excluded}" IsEnabled="{Binding CanJoinRandom}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" />
                            </StackPanel></Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

                </StackPanel>
            
        </Expander>
        <Expander x:Name="QuoteLibrary" IsExpanded="False" Style="{StaticResource LibraryExpander}">
            <Expander.Header><StackPanel><TextBlock Text="{present:Translate '文字'}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedQuote.Name}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" /></StackPanel></Expander.Header>

                <StackPanel>
                    <WrapPanel Margin="0,0,0,12"><ToggleButton Content="{present:Translate '每次随机'}" IsChecked="{Binding QuoteRandom, Mode=OneWay}" Click="RandomQuote_Click" Style="{StaticResource LibraryToggle}" /><CheckBox Content="{present:Translate '随机时只选收藏'}" IsChecked="{Binding QuoteFavoritesOnly}" VerticalAlignment="Center" Margin="16,0,0,0" /></WrapPanel>
                    <DockPanel Margin="0,0,0,12"><CheckBox DockPanel.Dock="Right" Content="{present:Translate '只看收藏'}" IsChecked="{Binding ShowFavoriteQuotes}" VerticalAlignment="Center" /><WrapPanel><Button Content="{present:Translate '导入文字列表'}" Click="ImportQuotes_Click" Padding="12,7" Margin="0,0,8,0" /><Button Content="{present:Translate '恢复默认'}" Click="RestoreQuotes_Click" Padding="12,7" /></WrapPanel></DockPanel>

                        <ItemsControl x:Name="QuoteCards" present:ReorderButton.EnableDrop="True" ItemsSource="{Binding VisibleQuotes}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{DynamicResource MediaCardColumns}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                            <Border LayoutTransform="{DynamicResource MediaCardTransform}" Style="{StaticResource LibraryCard}"><StackPanel>
                                <DockPanel><present:ReorderButton DockPanel.Dock="Right" ReorderRequested="MediaOrder_Requested" /><Border Style="{StaticResource MaterialOriginBadge}"><TextBlock Text="{Binding Origin}" FontSize="10" Foreground="{DynamicResource TextBrush}" /></Border></DockPanel>
                                <TextBlock Text="{Binding Text}" FontFamily="{DynamicResource FocusQuoteFont}" FontSize="14" LineHeight="24" TextWrapping="Wrap" MaxHeight="144" TextTrimming="CharacterEllipsis" /><present:QuoteAttributionText Quote="{Binding Quote}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SourceDescription}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceInfo}" />
                                <WrapPanel Margin="0,12,0,0"><Button Content="{present:Translate '使用'}" Click="UseQuote_Click" Padding="10,5" FontSize="11" Margin="0,0,8,0" /><CheckBox Content="{present:Translate '收藏'}" IsChecked="{Binding Favorite}" VerticalAlignment="Center" FontSize="11" /><Button Content="{present:Translate '编辑'}" Click="EditQuote_Click" Visibility="{Binding Custom, Converter={StaticResource BoolVisibility}}" Padding="8,5" FontSize="11" Margin="4,0,0,0" /><Button Content="{present:Translate '删除'}" Click="RemoveQuote_Click" Visibility="{Binding Custom, Converter={StaticResource BoolVisibility}}" Padding="8,5" FontSize="11" Margin="4,0,0,0" /><Button Content="{present:Translate '出处'}" Click="QuoteSource_Click" Padding="8,5" FontSize="11" IsEnabled="{Binding HasSourceLink}" /></WrapPanel>
                                <CheckBox Content="{present:Translate '不参与随机'}" IsChecked="{Binding Excluded}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" />
                            </StackPanel></Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

                    <Expander x:Name="QuoteEditor" Foreground="{DynamicResource TextBrush}" Header="{present:Translate '添加文字或摘录'}" Margin="0,12,0,0">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="{present:Translate '句子'}" Style="{StaticResource Caption}" /><TextBox Text="{Binding NewQuoteText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65" />
                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{present:Translate '作者（可选）'}" Style="{StaticResource Caption}" /><TextBox Text="{Binding NewQuoteAuthor, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{present:Translate '作品（可选）'}" Style="{StaticResource Caption}" /><TextBox Text="{Binding NewQuoteWork, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid>
                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{present:Translate '译者（可选）'}" Style="{StaticResource Caption}" /><TextBox Text="{Binding NewQuoteTranslator, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{present:Translate '来源（可选）'}" Style="{StaticResource Caption}" /><TextBox Text="{Binding NewQuoteSource, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid>
                            <TextBlock Text="{present:Translate '出处说明（可选）'}" Style="{StaticResource Caption}" Margin="0,12,0,6" /><TextBox Text="{Binding NewQuoteNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" />
                            <WrapPanel Margin="0,14,0,0"><Button Content="{present:Translate '保存文字'}" Command="{Binding SaveQuoteCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" /><Button Content="{present:Translate '取消编辑'}" Command="{Binding CancelQuoteCommand}" /></WrapPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            
        </Expander>
        <Expander x:Name="SoundLibrary" IsExpanded="False" Style="{StaticResource LibraryExpander}">
            <Expander.Header><StackPanel><TextBlock Text="{present:Translate '声音'}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedSound.Name}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" /></StackPanel></Expander.Header>

                <StackPanel>
                    <DockPanel Margin="0,0,0,12"><CheckBox DockPanel.Dock="Right" Content="{present:Translate '只看收藏'}" IsChecked="{Binding ShowFavoriteSounds}" VerticalAlignment="Center" /><WrapPanel><ToggleButton Content="{present:Translate '不播放'}" IsChecked="{Binding NoSound, Mode=OneWay}" Click="NoSound_Click" Style="{StaticResource LibraryToggle}" Margin="0,0,8,0" /><Button Content="{present:Translate '导入音频'}" Click="ImportSound_Click" Padding="12,7" Margin="0,0,8,0" /><Button Content="{present:Translate '恢复默认'}" Click="RestoreSounds_Click" Padding="12,7" /></WrapPanel></DockPanel>
                    <views:FocusAudioControls ShowLibrary="False" Margin="0,0,0,16" />

                        <ItemsControl x:Name="SoundCards" present:ReorderButton.EnableDrop="True" ItemsSource="{Binding VisibleSounds}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{DynamicResource MediaCardColumns}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                            <Border LayoutTransform="{DynamicResource MediaCardTransform}" Style="{StaticResource LibraryCard}"><StackPanel><DockPanel><present:ReorderButton DockPanel.Dock="Right" ReorderRequested="MediaOrder_Requested" /><Border Style="{StaticResource MaterialOriginBadge}"><TextBlock Text="{Binding Origin}" FontSize="10" Foreground="{DynamicResource TextBrush}" /></Border></DockPanel><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" /><TextBlock Text="{Binding Credit}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
                                <WrapPanel Margin="0,12,0,0"><Button Content="{present:Translate '使用'}" Click="UseSound_Click" Padding="10,5" FontSize="11" Margin="0,0,8,0" /><CheckBox Content="{present:Translate '收藏'}" IsChecked="{Binding Favorite}" VerticalAlignment="Center" FontSize="11" /><Button Content="{present:Translate '删除'}" Click="RemoveSound_Click" Visibility="{Binding Custom, Converter={StaticResource BoolVisibility}}" Padding="8,5" FontSize="11" Margin="4,0,0,0" /><Button Content="{present:Translate '来源'}" Click="SoundSource_Click" Padding="8,5" FontSize="11" /></WrapPanel>
                            </StackPanel></Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

                    <CheckBox Content="{present:Translate '专注或休息结束时播放提示音'}" IsChecked="{Binding ReminderSounds}" Margin="0,16,0,0" />
                </StackPanel>
            
        </Expander>
        <TextBlock Text="{present:Translate '默认素材保留，可设置不参与随机或不播放。自定义素材删除前需确认，原文件不受影响。'}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,16,0,0" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
