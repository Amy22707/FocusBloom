<UserControl x:Class="FocusBloom.Desktop.Views.StatisticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <UserControl.Resources>
        <Style x:Key="StatisticsTooltip" TargetType="ToolTip"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><ContentPresenter /></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="StatisticsTool" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="8,5" /><Setter Property="FontSize" Value="11" /><Setter Property="MinHeight" Value="30" /></Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Height" Value="34" /><Setter Property="MinHeight" Value="34" /><Setter Property="FontSize" Value="12" /></Style>
        <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}"><Setter Property="Height" Value="34" /><Setter Property="MinHeight" Value="34" /><Setter Property="FontSize" Value="12" /></Style>
        <Style TargetType="primitives:DatePickerTextBox" BasedOn="{StaticResource {x:Type primitives:DatePickerTextBox}}"><Setter Property="MinHeight" Value="0" /><Setter Property="Height" Value="30" /><Setter Property="Padding" Value="4,2" /><Setter Property="FontSize" Value="12" /></Style>
        <Style x:Key="StatisticsHit" TargetType="Button"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Padding" Value="0" /><Setter Property="Cursor" Value="Hand" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.7" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </UserControl.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,8">
            <WrapPanel>
                <ComboBox x:Name="StatisticsRangeSelector" Width="100" ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range}" Margin="0,0,8,0" />
                <Button Content="‹" Command="{Binding PreviousCommand}" Style="{StaticResource StatisticsTool}" IsEnabled="{Binding IsValid}" /><TextBlock Text="{Binding RangeLabel}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="8,0" /><Button Content="›" Command="{Binding NextCommand}" Style="{StaticResource StatisticsTool}" IsEnabled="{Binding IsValid}" />
                <Button Content="今天" Command="{Binding TodayCommand}" Style="{StaticResource StatisticsTool}" Margin="6,0,8,0" />
                <DatePicker x:Name="StatisticsAnchorDate" SelectedDate="{Binding Anchor}" Width="150" Margin="0,0,8,0" ToolTip="跳转日期" Visibility="{Binding ShowAnchor, Converter={StaticResource BoolVisibility}}" />
                <Button x:Name="ExportStatisticsButton" Content="导出摘要" Click="Export_Click" Style="{StaticResource StatisticsTool}" IsEnabled="{Binding IsValid}" />
            </WrapPanel>
            <WrapPanel Visibility="{Binding IsCustom, Converter={StaticResource BoolVisibility}}" Margin="0,6,0,0"><TextBlock Text="起止日期" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" /><DatePicker x:Name="StatisticsFromDate" SelectedDate="{Binding CustomFrom}" Width="145" /><TextBlock Text="—" VerticalAlignment="Center" Margin="8,0" /><DatePicker x:Name="StatisticsToDate" SelectedDate="{Binding CustomTo}" Width="145" /></WrapPanel>
            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ComboBox x:Name="StatisticsFolderSelector" ItemsSource="{Binding FolderChoices}" SelectedItem="{Binding SelectedFolder}" DisplayMemberPath="Name" ToolTip="计时文件夹" />
                <ComboBox x:Name="StatisticsProjectSelector" Grid.Column="2" ItemsSource="{Binding ProjectChoices}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Name" ToolTip="专注项目" />
                <ComboBox x:Name="StatisticsTodoSelector" Grid.Column="4" ItemsSource="{Binding TodoChoices}" SelectedItem="{Binding SelectedTodo}" DisplayMemberPath="Name" ToolTip="关联待办" />
            </Grid>
            <TextBlock Text="{Binding ValidationText}" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" />
        </StackPanel>
        <ScrollViewer x:Name="StatisticsViewport" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="Viewport_SizeChanged">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,0,0,10"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource CardBrush}" CornerRadius="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tooltip}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <StackPanel x:Name="StatisticsContent" />
                <Expander Header="统计口径" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,12"><TextBlock Text="统计已保存记录，当前会话结束后自动加入。时长按实际日期拆分，排除暂停和休息；次数按会话结束日计算，平均时长按这些会话的完整有效时长计算。成果按会话结束日汇总，不同单位分别合计。待办完成状态展示当前状态，预估比较使用累计投入。" TextWrapping="Wrap" Margin="0,8,0,0" /></Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
