<UserControl x:Class="FocusBloom.Desktop.Views.ReflectionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <UserControl.Resources>
        <Style x:Key="ReflectionTool" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,6" /><Setter Property="FontSize" Value="12" /></Style>
        <Style TargetType="primitives:DatePickerTextBox" BasedOn="{StaticResource {x:Type primitives:DatePickerTextBox}}"><Setter Property="MinHeight" Value="0" /><Setter Property="Height" Value="30" /><Setter Property="Padding" Value="4,2" /><Setter Property="FontSize" Value="12" /></Style>
    </UserControl.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10"><Button x:Name="ReflectionReminderButton" DockPanel.Dock="Right" Content="{Binding ReminderLabel}" Click="Reminder_Click" Style="{StaticResource ReflectionTool}" /><TextBlock Text="心情与每日复盘" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,10"><Button Content="‹" Command="{Binding PreviousMonthCommand}" Style="{StaticResource ReflectionTool}" /><TextBlock Text="{Binding MonthLabel}" FontSize="13" FontWeight="SemiBold" Margin="9,0" VerticalAlignment="Center" /><Button Content="›" Command="{Binding NextMonthCommand}" Style="{StaticResource ReflectionTool}" /><Button Content="今天" Command="{Binding TodayCommand}" Style="{StaticResource ReflectionTool}" Margin="6,0,8,0" /><DatePicker x:Name="ReflectionDatePicker" SelectedDate="{Binding Date}" Width="155" Height="34" MinHeight="34" FontSize="12" ToolTip="选择日期，可使用年份和月份列表跳转" /></WrapPanel>
        <ScrollViewer x:Name="ReflectionViewport" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="Viewport_SizeChanged">
            <Grid x:Name="ReflectionContent"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel x:Name="MonthPanel">
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="{Binding MonthSummary}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12" /><StackPanel x:Name="MoodCalendar" /></StackPanel></Border>
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14"><StackPanel><TextBlock Text="心情变化" FontSize="15" FontWeight="SemiBold" /><ContentControl x:Name="MoodTrend" Margin="0,12,0,4" /><TextBlock Text="只展示已记录的心情；空白日期不补值。点击圆点查看当天记录。" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" /></StackPanel></Border>
                </StackPanel>
                <Border x:Name="DayPanel" Grid.Column="2" VerticalAlignment="Top" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                    <StackPanel>
                        <TextBlock Text="{Binding DateLabel}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding MoodTitle}" FontSize="17" Margin="0,12,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding Tags}" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <Button x:Name="EditReflectionButton" Content="{Binding EditLabel}" Click="Edit_Click" IsEnabled="{Binding CanEdit}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="12,7" FontSize="12" Margin="0,12,0,16" />
                        <TextBlock Text="感受" FontSize="11" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{Binding Feeling}" TextWrapping="Wrap" FontSize="13" Margin="0,5,0,12" />
                        <TextBlock Text="想记住的事" FontSize="11" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{Binding Highlights}" TextWrapping="Wrap" FontSize="13" Margin="0,5,0,12" />
                        <TextBlock Text="明天的第一步" FontSize="11" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{Binding NextStep}" TextWrapping="Wrap" FontSize="13" Margin="0,5,0,16" />
                        <Border Background="{DynamicResource FieldBrush}" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="这一天的投入与完成" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="{Binding FocusText}" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,3" /><TextBlock Text="{Binding SessionText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{Binding TodoText}" FontSize="11" Margin="0,6,0,0" ToolTip="按待办的实际完成时间统计。历史待办未保存完成日期的，不推定日期。" /><TextBlock Text="{Binding HabitText}" FontSize="11" Margin="0,6,0,0" />
                            <Expander x:Name="ReflectionSummaryExpander" Header="查看完成事项与专注成果" IsExpanded="{Binding SummaryExpanded}" FontSize="11" Margin="0,12,0,0"><StackPanel Margin="0,8,0,0"><ItemsControl ItemsSource="{Binding Summary.CompletedTodos}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,0,0,7" FontSize="12" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl ItemsSource="{Binding OutcomeLines}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4,0,7" FontSize="12" Foreground="{DynamicResource MutedBrush}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Expander>
                        </StackPanel></Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
