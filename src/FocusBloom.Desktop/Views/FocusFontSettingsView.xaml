<UserControl x:Class="FocusBloom.Desktop.Views.FocusFontSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel><Button DockPanel.Dock="Right" Content="恢复默认" Command="{Binding ResetCommand}" Padding="14,7" /><TextBlock Text="专注字体" FontSize="18" FontWeight="SemiBold" /></DockPanel>
        <TextBlock Text="分别选择中文、英文与计时数字，点击卡片即时应用。仅显示本机可用字体。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,20" />
        <TextBlock Text="中文" Style="{StaticResource Caption}" />
        <ListBox Style="{StaticResource FlowCardList}" x:Name="ChineseFontSelector" ItemsSource="{Binding ChineseFonts}" SelectedItem="{Binding Chinese}" ItemContainerStyle="{StaticResource ProjectItem}">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate><DataTemplate><Border Width="222" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{Binding Preview}" FontFamily="{Binding Typeface}" FontSize="16" Margin="0,12,0,0" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="英文" Style="{StaticResource Caption}" Margin="0,8,0,8" />
        <ListBox Style="{StaticResource FlowCardList}" x:Name="EnglishFontSelector" ItemsSource="{Binding EnglishFonts}" SelectedItem="{Binding English}" ItemContainerStyle="{StaticResource ProjectItem}">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate><DataTemplate><Border Width="222" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{Binding Preview}" FontFamily="{Binding Typeface}" FontSize="16" Margin="0,12,0,0" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="计时数字" Style="{StaticResource Caption}" Margin="0,8,0,8" />
        <TextBlock Text="选择机械刻字、工业仪表、终端等宽或简洁数字风格。" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12" />
        <ListBox Style="{StaticResource FlowCardList}" x:Name="TimerFontSelector" ItemsSource="{Binding TimerFonts}" SelectedItem="{Binding Timer}" ItemContainerStyle="{StaticResource ProjectItem}">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate><DataTemplate><Border Width="184" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{Binding Preview}" FontFamily="{Binding Typeface}" FontSize="28" FontWeight="Light" Typography.NumeralAlignment="Tabular" Margin="0,12,0,0" /><TextBlock Text="0123456789" FontFamily="{Binding Typeface}" FontSize="15" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Border Background="{DynamicResource SubtleBrush}" CornerRadius="14" Padding="20" Margin="0,8,0,0"><StackPanel>
            <TextBlock Text="组合预览" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
            <TextBlock Text="留一刻，给自己。 Make time for what matters." FontFamily="{Binding TextTypeface}" FontSize="18" LineHeight="30" Margin="0,12,0,0" />
            <TextBlock Text="00:25:00" FontFamily="{Binding Timer.Typeface}" FontSize="40" FontWeight="Light" Typography.NumeralAlignment="Tabular" Margin="0,12,0,0" />
        </StackPanel></Border>
    </StackPanel>
</UserControl>
