<UserControl x:Class="FocusBloom.Desktop.Views.FocusFontSettingsView"
             xmlns:loc="clr-namespace:FocusBloom.Desktop.Presentation" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel Margin="0,0,0,12" MaxWidth="350" HorizontalAlignment="Left">
            <TextBlock DockPanel.Dock="Left" Text="{loc:Translate '计时界面字号'}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding FocusSizePercent, StringFormat={}{0:0}%}" VerticalAlignment="Center" Margin="12,0,0,0" />
            <Slider x:Name="FocusSizeSelector" Width="170" Minimum="80" Maximum="120" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding FocusSizePercent}" AutomationProperties.Name="{loc:Translate '计时界面字号'}" />
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="{loc:Translate '恢复默认'}" Command="{Binding ResetCommand}" Padding="14,7" />
            <TextBlock Text="{loc:Translate '中文'}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
        </DockPanel>
        <ListBox Style="{StaticResource FlowCardList}" x:Name="ChineseFontSelector" ItemsSource="{Binding ChineseFonts}" SelectedItem="{Binding Chinese}" ItemContainerStyle="{StaticResource ProjectItem}">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate><DataTemplate><Border Width="222" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="{Binding Name, Converter={StaticResource UiTextConverter}}" FontSize="11" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{Binding Preview}" FontFamily="{Binding Typeface}" FontSize="16" Margin="0,12,0,0" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{loc:Translate '英文'}" Style="{StaticResource Caption}" Margin="0,8,0,8" />
        <ListBox Style="{StaticResource FlowCardList}" x:Name="EnglishFontSelector" ItemsSource="{Binding EnglishFonts}" SelectedItem="{Binding English}" ItemContainerStyle="{StaticResource ProjectItem}">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate><DataTemplate><Border Width="222" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="{Binding Name, Converter={StaticResource UiTextConverter}}" FontSize="11" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{Binding Preview}" FontFamily="{Binding Typeface}" FontSize="16" Margin="0,12,0,0" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{loc:Translate '计时数字'}" Style="{StaticResource Caption}" Margin="0,8,0,8" />
        <ListBox Style="{StaticResource FlowCardList}" x:Name="TimerFontSelector" ItemsSource="{Binding TimerFonts}" SelectedItem="{Binding Timer}" ItemContainerStyle="{StaticResource ProjectItem}">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate><DataTemplate><Border Width="184" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="{Binding Name, Converter={StaticResource UiTextConverter}}" FontSize="11" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{Binding Preview}" FontFamily="{Binding Typeface}" FontSize="28" FontWeight="Light" Typography.NumeralAlignment="Tabular" Margin="0,12,0,0" /><TextBlock Text="0123456789" FontFamily="{Binding Typeface}" FontSize="15" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Border Background="{DynamicResource SubtleBrush}" CornerRadius="14" Padding="20" Margin="0,8,0,0"><StackPanel>
            <TextBlock Text="{loc:Translate '组合预览'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
            <TextBlock Text="{loc:Translate '留一刻，给自己。 Make time for what matters.'}" FontFamily="{Binding TextTypeface}" FontSize="18" LineHeight="30" Margin="0,12,0,0" />
            <TextBlock Text="00:25:00" FontFamily="{Binding Timer.Typeface}" FontSize="40" FontWeight="Light" Typography.NumeralAlignment="Tabular" Margin="0,12,0,0" />
        </StackPanel></Border>
    </StackPanel>
</UserControl>
