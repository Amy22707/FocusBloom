<UserControl x:Class="FocusBloom.Desktop.Views.CalendarView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <UserControl.Resources><Style x:Key="CalendarEntryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="EntrySurface" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="EntrySurface" Property="Opacity" Value="0.8" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="EntrySurface" Property="Opacity" Value="0.65" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></UserControl.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel x:Name="CalendarToolbar" Margin="0,0,0,8">
            <StackPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="30" /><Setter Property="Height" Value="30" /><Setter Property="Padding" Value="8,4" /><Setter Property="FontSize" Value="11" /></Style>
                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="MinHeight" Value="32" /><Setter Property="Height" Value="32" /><Setter Property="FontSize" Value="12" /></Style>
                <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}"><Setter Property="MinHeight" Value="32" /><Setter Property="Height" Value="32" /><Setter Property="FontSize" Value="12" /></Style>
                <Style TargetType="primitives:DatePickerTextBox" BasedOn="{StaticResource {x:Type primitives:DatePickerTextBox}}"><Setter Property="MinHeight" Value="0" /><Setter Property="Height" Value="28" /><Setter Property="Padding" Value="4,2" /><Setter Property="FontSize" Value="12" /></Style>
            </StackPanel.Resources>
            <DockPanel>
                <ComboBox x:Name="ModeSelector" DockPanel.Dock="Right" Width="100" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Margin="12,0,0,0" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0" Visibility="{Binding TasksCalendar, Converter={StaticResource BoolVisibility}}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="‹" Click="Previous_Click" Width="24" Padding="0" /><TextBlock Text="{Binding Heading}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" /><Button Content="›" Click="Next_Click" Width="24" Padding="0" /><Button Content="今天" Click="Today_Click" Margin="6,0,0,0" /></StackPanel>
            </DockPanel>
            <WrapPanel Margin="0,6,0,0">
                <ComboBox x:Name="CalendarYearSelector" Width="85" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" ToolTip="年份" /><TextBlock Text="年" VerticalAlignment="Center" Margin="4,0,8,0" />
                <ComboBox x:Name="CalendarMonthSelector" Width="72" ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" ToolTip="月份" /><TextBlock Text="月" VerticalAlignment="Center" Margin="4,0,8,0" />
                <ComboBox x:Name="DayLayoutSelector" Width="76" ItemsSource="{Binding DayLayouts}" SelectedItem="{Binding DayLayout}" Visibility="{Binding ShowDayLayout, Converter={StaticResource BoolVisibility}}" Margin="0,0,6,0" />
                <DatePicker x:Name="JumpDate" Width="130" SelectedDateChanged="JumpDate_Changed" />
                <ComboBox Width="92" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Margin="8,0,0,0"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="课程表"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox>
                <Button Visibility="{Binding FocusOnly, Converter={StaticResource BoolVisibility}}" Content="安排时间" Click="NewPlan_Click" Margin="8,0,0,0" />
                <Button Visibility="{Binding TasksCalendar, Converter={StaticResource BoolVisibility}}" Content="课程管理" Click="Courses_Click" Margin="8,0,0,0" />
                <Button Content="提醒" Click="Reminders_Click" Margin="6,0,0,0" /><Button Content="导出ICS" Click="Export_Click" Margin="6,0,0,0" />
            </WrapPanel>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12"><ScrollViewer x:Name="CalendarViewport" ToolTip="左右拖动或用箭头翻页，点击事项查看详情" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="Viewport_SizeChanged" PreviewMouseLeftButtonDown="Viewport_MouseDown" PreviewMouseLeftButtonUp="Viewport_MouseUp" PreviewMouseWheel="Viewport_MouseWheel" IsManipulationEnabled="True" ManipulationCompleted="Viewport_ManipulationCompleted"><StackPanel x:Name="CalendarContent" /></ScrollViewer></Border>
    </Grid>
</UserControl>
