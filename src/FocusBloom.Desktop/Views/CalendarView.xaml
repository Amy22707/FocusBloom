<UserControl x:Class="FocusBloom.Desktop.Views.CalendarView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <UserControl.Resources>
        <Style x:Key="CalendarEntryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="EntrySurface" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="EntrySurface" Property="Opacity" Value="0.8" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="EntrySurface" Property="Opacity" Value="0.65" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="CalendarTool" TargetType="Button" BasedOn="{StaticResource QuietTool}"><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="8,4" /></Style>
    </UserControl.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel x:Name="CalendarToolbar" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="DayLayoutSelector" Width="76" Height="34" MinHeight="34" Padding="7,3" FontSize="12" ItemsSource="{Binding DayLayouts}" SelectedItem="{Binding DayLayout}" Visibility="{Binding ShowDayLayout, Converter={StaticResource BoolVisibility}}" Margin="0,0,6,0" />
                <ComboBox Width="92" Height="34" MinHeight="34" Padding="7,3" FontSize="12" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Margin="0,0,6,0"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="课程表"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox>
                <ComboBox x:Name="ModeSelector" Width="88" Height="34" MinHeight="34" Padding="7,3" FontSize="12" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Margin="0,0,10,0" />
                <Button Content="‹" Click="Previous_Click" Style="{StaticResource CalendarTool}" Width="26" ToolTip="上一页" /><Button Content="今天" Click="Today_Click" Style="{StaticResource CalendarTool}" /><Button Content="›" Click="Next_Click" Style="{StaticResource CalendarTool}" Width="26" ToolTip="下一页" />
                <Button x:Name="CalendarMoreButton" Content="···" Click="More_Click" Style="{StaticResource CalendarTool}" FontSize="17" Width="30" Padding="0" ToolTip="日历操作"><Button.ContextMenu><ContextMenu Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="安排时间" Click="NewPlan_Click" Visibility="{Binding FocusOnly, Converter={StaticResource BoolVisibility}}" /><MenuItem Header="课程管理" Click="Courses_Click" Visibility="{Binding TasksCalendar, Converter={StaticResource BoolVisibility}}" /><MenuItem Header="提醒" Click="Reminders_Click" /><Separator /><MenuItem Header="导出为 ICS…" Click="Export_Click" />
                </ContextMenu></Button.ContextMenu></Button>
            </StackPanel>
            <Grid><Button x:Name="CalendarDateButton" Click="JumpMenu_Click" Style="{StaticResource QuietTool}" Foreground="{DynamicResource TextBrush}" Padding="0,3" HorizontalContentAlignment="Left" ToolTip="选择年份、月份和日期"><DockPanel><TextBlock DockPanel.Dock="Right" Text="⌄" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="6,0,8,0" VerticalAlignment="Center" /><TextBlock Text="{Binding Heading}" FontSize="18" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></DockPanel></Button>
                <Popup x:Name="CalendarDatePopup" PlacementTarget="{Binding ElementName=CalendarDateButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><Border Width="310" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" DataContext="{Binding DataContext, ElementName=CalendarToolbar}"><StackPanel>
                    <TextBlock Text="跳转日期" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal"><ComboBox x:Name="CalendarYearSelector" Width="90" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" ToolTip="年份" /><TextBlock Text="年" VerticalAlignment="Center" Margin="6,0,12,0" /><ComboBox x:Name="CalendarMonthSelector" Width="76" ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" ToolTip="月份" /><TextBlock Text="月" VerticalAlignment="Center" Margin="6,0,0,0" /></StackPanel>
                    <DatePicker x:Name="JumpDate" SelectedDateChanged="JumpDate_Changed" Margin="0,12,0,12" />
                    <Button Content="完成" Click="CloseJump_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Padding="16,6" />
                </StackPanel></Border></Popup>
            </Grid>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <ContentControl x:Name="CalendarDayHeader" HorizontalContentAlignment="Stretch" Margin="0,0,0,4" />
            <ScrollViewer x:Name="CalendarViewport" Grid.Row="1" ToolTip="左右拖动或用箭头翻页，点击事项查看详情" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="Viewport_SizeChanged" PreviewMouseLeftButtonDown="Viewport_MouseDown" PreviewMouseLeftButtonUp="Viewport_MouseUp" PreviewMouseWheel="Viewport_MouseWheel" IsManipulationEnabled="True" ManipulationCompleted="Viewport_ManipulationCompleted"><StackPanel x:Name="CalendarContent" /></ScrollViewer>
        </Grid></Border>
    </Grid>
</UserControl>
