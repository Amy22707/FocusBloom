<UserControl x:Class="FocusBloom.Desktop.Views.BackupSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="把记录和素材一起带走" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="一个备份文件包含已保存的记录、待办、课表、习惯、心情、设置和自定义素材。可在这台电脑恢复，也可导入另一台电脑。" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,16" />
        <WrapPanel><Button x:Name="CreateBackupButton" Content="创建备份…" Click="Create_Click" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanOperate}" Margin="0,0,10,8" /><Button x:Name="RestoreBackupButton" Content="从备份恢复…" Click="Restore_Click" IsEnabled="{Binding CanOperate}" Margin="0,0,10,8" /><Button Content="打开备份文件夹" Click="OpenFolder_Click" Margin="0,0,0,8" /></WrapPanel>
        <TextBlock Text="{Binding RestoreHint}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
        <Border Background="{DynamicResource FieldBrush}" CornerRadius="12" Padding="14"><StackPanel>
            <CheckBox x:Name="AutomaticBackupInput" Content="每天自动备份" IsChecked="{Binding AutomaticEnabled}" IsEnabled="{Binding CanOperate}" />
            <TextBlock Text="开启后，每天首次运行时备份一次；软件保持打开时也会按天检查。只清理超出保留份数的自动备份，手动备份和恢复前备份始终保留。" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,12" />
            <DockPanel><Button Content="选择位置…" Click="ChooseFolder_Click" DockPanel.Dock="Right" Margin="10,0,0,0" IsEnabled="{Binding CanOperate}" /><TextBlock x:Name="BackupDirectoryLabel" Text="{Binding DirectoryPath}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="保留最近" VerticalAlignment="Center" Margin="0,0,10,0" /><ComboBox x:Name="BackupRetentionSelector" Width="90" SelectedItem="{Binding Keep}" IsEnabled="{Binding CanOperate}" /><TextBlock Text="份自动备份" VerticalAlignment="Center" Margin="10,0,0,0" /></StackPanel>
        </StackPanel></Border>
        <TextBlock Text="{Binding LastBackup}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,8" />
        <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,4,0,8" />
        <TextBlock x:Name="BackupStatusLabel" Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
