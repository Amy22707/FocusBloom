<UserControl x:Class="FocusBloom.Desktop.Views.GoalsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:present="clr-namespace:FocusBloom.Desktop.Presentation" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <UserControl.Resources>
        <Style TargetType="primitives:DatePickerTextBox" BasedOn="{StaticResource {x:Type primitives:DatePickerTextBox}}"><Setter Property="MinHeight" Value="0" /><Setter Property="Height" Value="30" /><Setter Property="Padding" Value="4,2" /><Setter Property="FontSize" Value="12" /></Style>
        <Style x:Key="DayHabitButton" TargetType="Button"><Setter Property="Padding" Value="18" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="30"><Grid><Border x:Name="Tint" Background="{Binding Color}" Opacity="0.08" CornerRadius="29" Margin="1" /><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center" /></Grid></Border><ControlTemplate.Triggers><DataTrigger Binding="{Binding Checked}" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.4" /></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </UserControl.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="NewGoalButton" Content="＋ 新建目标" Click="NewGoal_Click" Padding="12,7" Margin="0,0,8,0" /><Button x:Name="NewHabitButton" Content="＋ 新建习惯" Click="NewHabit_Click" Style="{StaticResource PrimaryButton}" Padding="12,7" /></StackPanel><StackPanel><TextBlock Text="目标与习惯" FontSize="20" FontWeight="SemiBold" /><TextBlock Visibility="{Binding ShowCards, Converter={StaticResource BoolVisibility}}" Text="{Binding TodayText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0" /></StackPanel></DockPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,10"><TextBlock Text="视图" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" /><ComboBox x:Name="CompletionViewSelector" ItemsSource="{Binding Views}" SelectedItem="{Binding View}" Width="96" Height="34" MinHeight="34" FontSize="12" /><ComboBox x:Name="CompletionScopeSelector" ItemsSource="{Binding CompletionChoices}" SelectedItem="{Binding SelectedCompletion}" DisplayMemberPath="Name" Width="230" Height="34" MinHeight="34" FontSize="12" Margin="10,0,0,0" Visibility="{Binding ShowCompletion, Converter={StaticResource BoolVisibility}}" /></WrapPanel>
        <Grid Grid.Row="2" Visibility="{Binding ShowDaily, Converter={StaticResource BoolVisibility}}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14"><WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center"><Button x:Name="DailyPreviousButton" Content="‹" Command="{Binding PreviousCommand}" Padding="10,5" /><DatePicker x:Name="DailyHabitDate" SelectedDate="{Binding Anchor}" Width="155" FontSize="12" Height="34" MinHeight="34" Margin="6,0" /><Button Content="›" Command="{Binding NextCommand}" Padding="10,5" /><Button Content="今天" Command="{Binding TodayCommand}" FontSize="12" Padding="10,5" Margin="8,0,0,0" /></WrapPanel><StackPanel><TextBlock Text="{Binding DayTitle}" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="{Binding DayCaption}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" /></StackPanel></DockPanel>
            <ScrollViewer x:Name="DailyViewport" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <Border CornerRadius="24" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,12,16"><StackPanel><DockPanel><TextBlock Text="{Binding DaySummary}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding DayRatio, StringFormat=P0}" FontSize="16" HorizontalAlignment="Right" Foreground="{DynamicResource AccentTextBrush}" /></DockPanel><ProgressBar Maximum="1" Value="{Binding DayRatio, Mode=OneWay}" Height="6" Margin="0,10,0,10" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SubtleBrush}" BorderThickness="0" /><TextBlock Text="{Binding DayEncouragement}" FontSize="12" Foreground="{DynamicResource MutedBrush}" /></StackPanel></Border>
                <ItemsControl x:Name="DayHabitCards" ItemsSource="{Binding DayHabits}" present:ReorderButton.EnableDrop="True" SizeChanged="DayCards_SizeChanged"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Background="Transparent" Margin="0,0,12,12" LayoutTransform="{DynamicResource GoalsCardTransform}"><Button x:Name="DayHabitCheckButton" Style="{StaticResource DayHabitButton}" MinHeight="108" IsEnabled="{Binding CanCheck}" Click="CheckDayHabit_Click"><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding TotalDays}" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="累计天" FontSize="10" Foreground="{DynamicResource MutedBrush}" /></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /><TextBlock Text="{Binding Schedule}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" /><TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,5,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></StackPanel><Border Grid.Column="2" Width="32" Height="32" CornerRadius="16" HorizontalAlignment="Right" VerticalAlignment="Center" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource SubtleBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Checked}" Value="True"><Setter Property="Background" Value="{Binding Color}" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock FontSize="19" TextAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="＋" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Checked}" Value="True"><Setter Property="Text" Value="✓" /><Setter Property="Foreground" Value="#36454B" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></Grid></Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,12,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Opacity" Value="0" /><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Opacity" Value="1" /></Trigger></Style.Triggers></Style></StackPanel.Style><present:ReorderButton ReorderRequested="DayHabitOrder_Requested" /><Button Content="···" Background="Transparent" Click="EditDayHabit_Click" Padding="5,0" ToolTip="编辑习惯" /></StackPanel>
                    </Grid>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Border CornerRadius="26" Background="{DynamicResource CardBrush}" Padding="28" Margin="0,0,12,14" Visibility="{Binding NoDayHabits, Converter={StaticResource BoolVisibility}}"><StackPanel HorizontalAlignment="Center"><TextBlock Text="从一件小事开始" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="给每天留一点可以坚持的事。" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,16" /><Button Content="建立第一个习惯" Click="NewHabit_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" /></StackPanel></Border>
                <StackPanel Visibility="{Binding HasDayGoals, Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0"><TextBlock Text="目标进度" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" /><ItemsControl x:Name="DayGoalCards" ItemsSource="{Binding DayGoals}" present:ReorderButton.EnableDrop="True"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{DynamicResource GoalsCardColumns}" VerticalAlignment="Top" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border CornerRadius="24" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,12,12" LayoutTransform="{DynamicResource GoalsCardTransform}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="···" Click="EditGoal_Click" Background="Transparent" Padding="4,0" /><present:ReorderButton DockPanel.Dock="Right" ReorderRequested="DayGoalOrder_Requested" /><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></DockPanel><TextBlock Text="{Binding ValueText}" FontSize="17" Margin="0,10,0,0" /><ProgressBar Maximum="1" Value="{Binding Ratio, Mode=OneWay}" Height="5" BorderThickness="0" Background="{DynamicResource SubtleBrush}" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,8" /><TextBlock Text="{Binding State}" FontSize="11" Foreground="{DynamicResource MutedBrush}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
            </StackPanel></ScrollViewer>
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding ShowCards, Converter={StaticResource BoolVisibility}}"><StackPanel>
            <TextBlock Text="专注目标" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock Text="为每天、每周或一段时间设一个目标。时长和次数从专注记录自动累计。" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,14" Visibility="{Binding NoGoals, Converter={StaticResource BoolVisibility}}" />
            <ItemsControl x:Name="GoalCards" ItemsSource="{Binding Goals}" present:ReorderButton.EnableDrop="True"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{DynamicResource GoalsCardColumns}" VerticalAlignment="Top" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                <Border LayoutTransform="{DynamicResource GoalsCardTransform}" MinHeight="160" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="24" Padding="14" Margin="0,0,10,10"><StackPanel>
                    <DockPanel><Button DockPanel.Dock="Right" Content="···" Click="EditGoal_Click" Padding="5,0" Background="Transparent" ToolTip="修改或删除目标" /><present:ReorderButton DockPanel.Dock="Right" ReorderRequested="GoalOrder_Requested" /><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /></DockPanel>
                    <TextBlock Text="{Binding Scope}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Period}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ValueText}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ValueText}" />
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Ratio, Mode=OneWay}" Height="6" Margin="0,8,0,8" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SubtleBrush}" BorderThickness="0" />
                    <TextBlock Text="{Binding State}" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" />
                </StackPanel></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="习惯打卡" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,12" />
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="24" Padding="24" Margin="0,0,10,10" Visibility="{Binding NoHabits, Converter={StaticResource BoolVisibility}}"><StackPanel HorizontalAlignment="Center" Margin="0,12"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="32" HorizontalAlignment="Center" /><TextBlock Text="从一件小事开始" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,6" /><TextBlock Text="每天一点，也算向前。" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" /><Button Content="建立第一个习惯" Click="NewHabit_Click" Style="{StaticResource PrimaryButton}" FontSize="12" Margin="0,18,0,0" HorizontalAlignment="Center" /></StackPanel></Border>
            <ItemsControl x:Name="HabitCards" ItemsSource="{Binding Habits}" present:ReorderButton.EnableDrop="True"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{DynamicResource GoalsCardColumns}" VerticalAlignment="Top" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                <Border LayoutTransform="{DynamicResource GoalsCardTransform}" MinHeight="168" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="24" Padding="14" Margin="0,0,10,10"><StackPanel>
                    <DockPanel><Button DockPanel.Dock="Right" Content="···" Click="EditHabit_Click" Padding="5,0" Background="Transparent" ToolTip="修改或删除习惯" /><present:ReorderButton DockPanel.Dock="Right" ReorderRequested="HabitOrder_Requested" /><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /></DockPanel>
                    <TextBlock Text="{Binding Scope}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Schedule}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Streak}" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding Month}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" /><TextBlock Text="{Binding Reminder}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" Visibility="{Binding Habit.Reminder, Converter={StaticResource BoolVisibility}}" />
                    <WrapPanel Margin="0,12,0,0"><Button x:Name="HabitCheckButton" Content="{Binding CheckText}" IsEnabled="{Binding CanCheck}" Click="CheckHabit_Click" Padding="10,6" FontSize="11" Margin="0,0,8,0" /><Button Content="历史" Click="HabitHistory_Click" Padding="10,6" FontSize="11" /></WrapPanel>
                </StackPanel></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></ScrollViewer>
        <present:GoalCompletionView Grid.Row="2" Visibility="{Binding ShowCompletion, Converter={StaticResource BoolVisibility}}" />
    </Grid>
</UserControl>
